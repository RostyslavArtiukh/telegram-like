@inject TelegramLikeSession Session
@inject ITelegramLikeRealtimeClient Realtime
@inject PresenceHeartbeat Heartbeat
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="chats">TelegramLike</a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="nav flex-column">
        @if (Session.UserId is not null)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="chats">💬 Chats</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="notifications">🔔 Notifications</NavLink>
            </div>
            <div class="px-3 py-2 text-white-50 small">
                Signed in as <b>@Session.Username</b>
            </div>
            <div class="nav-item px-3">
                <button type="button" class="nav-link btn btn-link text-start w-100 border-0" @onclick="SignOutAsync">Sign out</button>
            </div>
        }
    </nav>
</div>

@code {
    private async Task SignOutAsync()
    {
        Heartbeat.Stop();
        try { await Realtime.DisconnectAsync(); } catch { /* already down is fine */ }
        await Session.LogoutAsync();
        Nav.NavigateTo("/");
    }
}
