@inject TelegramLikeSession Session
@inject ITelegramLikeRealtimeClient Realtime
@inject PresenceHeartbeat Heartbeat
@inject NavigationManager Navigation

<MudNavMenu>
    @if (Session.UserId is not null)
    {
        <MudNavLink Href="chats" Icon="@Icons.Material.Filled.Chat">Chats</MudNavLink>
        <MudNavLink Href="notifications" Icon="@Icons.Material.Filled.Notifications">Notifications</MudNavLink>

        <MudDivider Class="my-2" />

        <div class="px-4 py-2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Signed in as <b>@Session.Username</b>
            </MudText>
        </div>

        <div class="px-2">
            <MudButton OnClick="SignOutAsync" Variant="Variant.Text" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Logout" FullWidth="true" Class="justify-start">
                Sign out
            </MudButton>
        </div>
    }
</MudNavMenu>

@code {
    private async Task SignOutAsync()
    {
        Heartbeat.Stop();
        try { await Realtime.DisconnectAsync(); } catch { /* already down is fine */ }
        await Session.LogoutAsync();
        Navigation.NavigateTo("/");
    }
}
