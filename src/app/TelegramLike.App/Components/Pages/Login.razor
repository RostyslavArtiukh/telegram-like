@page "/"
@inject TelegramLikeSession Session
@inject TelegramLikeRealtimeClient Realtime
@inject PresenceHeartbeat Heartbeat
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-8">
    <MudCard Elevation="4">
        <MudCardContent>
            <MudText Typo="Typo.h4" GutterBottom="true">Sign in</MudText>

            @if (showAccountCreatedNotice)
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">Account created! Please sign in.</MudAlert>
            }

            <MudTextField @bind-Value="emailAddress" Label="Email" Placeholder="you@example.com"
                          Variant="Variant.Outlined" InputType="InputType.Email" Class="mb-3" Immediate="true" />
            <MudTextField @bind-Value="password" Label="Password" Placeholder="Your password"
                          Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-3" Immediate="true"
                          OnKeyDown="SubmitOnEnterAsync" />

            @if (errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
            }

            <MudButton OnClick="SignInAsync" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Disabled="isSigningIn" StartIcon="@Icons.Material.Filled.Login">
                @(isSigningIn ? "Signing in…" : "Sign in")
            </MudButton>

            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
                No account? <MudLink Href="register">Register</MudLink>
            </MudText>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "registered")] private string? RegisteredFlag { get; set; }

    private string emailAddress = "";
    private string password = "";
    private string? errorMessage;
    private bool isSigningIn;
    private bool showAccountCreatedNotice;

    protected override async Task OnInitializedAsync()
    {
        showAccountCreatedNotice = RegisteredFlag == "true";

        // Session token survives in the store (in-memory today, SecureStorage on
        // Android later) — skip the login form when it still exchanges for a JWT.
        if (await Session.GetAccessTokenAsync() is not null)
            await EnterAppAsync();
    }

    private Task SubmitOnEnterAsync(KeyboardEventArgs args)
        => args.Key is "Enter" or "NumpadEnter" ? SignInAsync() : Task.CompletedTask;

    private async Task SignInAsync()
    {
        errorMessage = null;
        isSigningIn = true;
        try
        {
            await Session.LoginAsync(emailAddress.Trim(), password);
            await EnterAppAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = $"Cannot reach the backend at {AppConfig.GatewayBaseUrl} — is the stack running?";
        }
        finally
        {
            isSigningIn = false;
        }
    }

    private async Task EnterAppAsync()
    {
        // Realtime is best-effort: the app still works over HTTP without pushes.
        try
        {
            if (!Realtime.IsConnected)
                await Realtime.ConnectAsync();
        }
        catch { /* reconnect logic retries when the hub comes back */ }

        Heartbeat.Start();
        Navigation.NavigateTo("/chats");
    }
}
