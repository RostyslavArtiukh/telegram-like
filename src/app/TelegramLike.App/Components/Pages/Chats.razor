@page "/chats"
@implements IDisposable
@inject TelegramLikeSession Session
@inject IChatsApi ChatsApi
@inject IIdentityUsersApi IdentityUsers
@inject INotificationsApi NotificationsApi
@inject ITelegramLikeRealtimeClient Realtime
@inject NavigationManager Navigation

<div class="d-flex align-center justify-space-between mb-4">
    <div class="d-flex align-center" style="gap:8px">
        <MudText Typo="Typo.h4">Chats</MudText>
        @if (unreadNotificationCount > 0)
        {
            <MudChip T="string" Color="Color.Error" Size="Size.Small">@unreadNotificationCount unread</MudChip>
        }
    </div>
    <MudButton Href="notifications" Variant="Variant.Outlined" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Notifications">Notifications</MudButton>
</div>

<MudGrid>
    <MudItem xs="12" md="7">
        @if (chatListError is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                @chatListError
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="ml-2"
                           OnClick="ReloadChatsAndUnreadAsync">Retry</MudButton>
            </MudAlert>
        }
        else if (myChats is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (myChats.Count == 0)
        {
            <MudAlert Severity="Severity.Info">No chats yet — create one on the right.</MudAlert>
        }
        else
        {
            <MudList T="string" Class="pa-0">
                @foreach (var chat in myChats)
                {
                    <MudListItem T="string" OnClick="@(() => Navigation.NavigateTo($"/chat/{chat.ChatId}"))"
                                 Icon="@ChatTypeIcon(chat.Type)">
                        <div class="d-flex align-center justify-space-between" style="width:100%">
                            <div>
                                <MudText Typo="Typo.body1">@(chat.Name ?? "(direct)")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @chat.ActiveMemberCount member(s) · you are @chat.MyRole
                                </MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="@ChatTypeColor(chat.Type)">@chat.Type</MudChip>
                        </div>
                    </MudListItem>
                    <MudDivider />
                }
            </MudList>
        }
    </MudItem>

    <MudItem xs="12" md="5">
        <MudCard Elevation="2" Class="mb-4">
            <MudCardContent>
                <MudText Typo="Typo.h6" GutterBottom="true">Create a group chat</MudText>
                <div class="d-flex align-center" style="gap:8px">
                    <MudTextField @bind-Value="newGroupName" Placeholder="Group name" Variant="Variant.Outlined"
                                  Immediate="true" Class="flex-grow-1" />
                    <MudButton OnClick="CreateGroupChatAsync" Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="isSubmitting">Create</MudButton>
                </div>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="2" Class="mb-4">
            <MudCardContent>
                <MudText Typo="Typo.h6" GutterBottom="true">Create a broadcast channel</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Only owners/admins can post; everyone else joins as a viewer.
                </MudText>
                <div class="d-flex align-center" style="gap:8px">
                    <MudTextField @bind-Value="newBroadcastName" Placeholder="Channel name" Variant="Variant.Outlined"
                                  Immediate="true" Class="flex-grow-1" />
                    <MudButton OnClick="CreateBroadcastChannelAsync" Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="isSubmitting">Create</MudButton>
                </div>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="2" Class="mb-4">
            <MudCardContent>
                <MudText Typo="Typo.h6" GutterBottom="true">Start a direct chat</MudText>
                <div class="d-flex align-center" style="gap:8px">
                    <MudTextField @bind-Value="directChatUsername" Placeholder="username" Variant="Variant.Outlined"
                                  Immediate="true" Class="flex-grow-1" />
                    <MudButton OnClick="StartDirectChatAsync" Variant="Variant.Outlined" Color="Color.Primary"
                               Disabled="isSubmitting">Start</MudButton>
                </div>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="2" Class="mb-4">
            <MudCardContent>
                <MudText Typo="Typo.h6" GutterBottom="true">Join by chat id</MudText>
                <div class="d-flex align-center" style="gap:8px">
                    <MudTextField @bind-Value="joinChatIdText" Placeholder="00000000-…" Variant="Variant.Outlined"
                                  Immediate="true" Class="flex-grow-1" />
                    <MudButton OnClick="JoinChatByIdAsync" Variant="Variant.Outlined" Color="Color.Primary"
                               Disabled="isSubmitting">Join</MudButton>
                </div>
            </MudCardContent>
        </MudCard>

        @if (actionError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true">@actionError</MudAlert>
        }
    </MudItem>
</MudGrid>

@code {
    private IReadOnlyList<ChatSummary>? myChats;
    private string? chatListError;
    private long unreadNotificationCount;
    private string newGroupName = "";
    private string newBroadcastName = "";
    private string directChatUsername = "";
    private string joinChatIdText = "";
    private string? actionError;
    private bool isSubmitting;
    private Guid currentUserId;

    protected override async Task OnInitializedAsync()
    {
        if (Session.UserId is not { } userId)
        {
            Navigation.NavigateTo("/");
            return;
        }
        currentUserId = userId;

        Realtime.ChatActivity += OnChatActivityPush;
        Realtime.UnreadCountChanged += OnUnreadCountChanged;

        await ReloadChatsAndUnreadAsync();
    }

    private async Task ReloadChatsAndUnreadAsync()
    {
        try
        {
            myChats = await ChatsApi.GetMyChatsAsync(currentUserId);
            chatListError = null;
        }
        catch (Exception)
        {
            // A transient Chats outage must not throw out of a lifecycle method —
            // degrade to a retryable error state instead of an eternal spinner.
            chatListError = "Chats are temporarily unavailable.";
        }

        try { unreadNotificationCount = await NotificationsApi.GetUnreadCountAsync(currentUserId); }
        catch { /* cosmetic — badge just stays at its last known value */ }
    }

    // Hub events arrive on background threads — hop onto the UI thread to touch state.
    private void OnChatActivityPush(MessageSentPush push) =>
        _ = InvokeAsync(async () => { await ReloadChatsAndUnreadAsync(); StateHasChanged(); });

    private void OnUnreadCountChanged() =>
        _ = InvokeAsync(async () =>
        {
            try { unreadNotificationCount = await NotificationsApi.GetUnreadCountAsync(currentUserId); } catch { /* cosmetic */ }
            StateHasChanged();
        });

    private Task CreateGroupChatAsync() => RunGuardedActionAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(newGroupName)) return;
        var createdChatId = await ChatsApi.CreateGroupChatAsync(currentUserId, newGroupName.Trim());
        Navigation.NavigateTo($"/chat/{createdChatId}");
    });

    private Task CreateBroadcastChannelAsync() => RunGuardedActionAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(newBroadcastName)) return;
        var createdChatId = await ChatsApi.CreateBroadcastChannelAsync(currentUserId, newBroadcastName.Trim());
        Navigation.NavigateTo($"/chat/{createdChatId}");
    });

    private Task StartDirectChatAsync() => RunGuardedActionAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(directChatUsername)) return;
        var otherUserId = await IdentityUsers.GetUserIdByUsernameAsync(directChatUsername.Trim());
        if (otherUserId is null) { actionError = $"User '{directChatUsername}' not found."; return; }
        var createdChatId = await ChatsApi.CreateDirectChatAsync(currentUserId, otherUserId.Value);
        Navigation.NavigateTo($"/chat/{createdChatId}");
    });

    private Task JoinChatByIdAsync() => RunGuardedActionAsync(async () =>
    {
        if (!Guid.TryParse(joinChatIdText.Trim(), out var chatId)) { actionError = "Not a valid chat id."; return; }
        await ChatsApi.JoinChatAsync(currentUserId, chatId);
        Navigation.NavigateTo($"/chat/{chatId}");
    });

    private async Task RunGuardedActionAsync(Func<Task> action)
    {
        actionError = null;
        isSubmitting = true;
        try { await action(); }
        catch (Exception ex) { actionError = ex.Message; }
        finally { isSubmitting = false; }
    }

    private static Color ChatTypeColor(ChatType chatType) => chatType switch
    {
        ChatType.Direct => Color.Default,
        ChatType.Group => Color.Primary,
        ChatType.Broadcast => Color.Info,
        _ => Color.Default
    };

    private static string ChatTypeIcon(ChatType chatType) => chatType switch
    {
        ChatType.Direct => Icons.Material.Filled.Person,
        ChatType.Group => Icons.Material.Filled.Group,
        ChatType.Broadcast => Icons.Material.Filled.Campaign,
        _ => Icons.Material.Filled.Chat
    };

    public void Dispose()
    {
        Realtime.ChatActivity -= OnChatActivityPush;
        Realtime.UnreadCountChanged -= OnUnreadCountChanged;
    }
}
