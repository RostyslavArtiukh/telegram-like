@page "/chat/{ChatId:guid}"
@implements IAsyncDisposable
@inject TelegramLikeSession Session
@inject ChatsApiClient ChatsApi
@inject MessagingApiClient MessagingApi
@inject PresenceApiClient PresenceApi
@inject NotificationsApiClient NotificationsApi
@inject UsernameCache Usernames
@inject TelegramLikeRealtimeClient Realtime
@inject NavigationManager Navigation

@if (chatLoadError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-2">@chatLoadError</MudAlert>
    <MudButton Href="chats" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">Back to chats</MudButton>
}
else if (openedChat is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <div class="d-flex justify-space-between align-start mb-2">
        <div>
            <MudText Typo="Typo.h5">@GetChatTitle()</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @if (openedChat.Type == ChatType.Direct)
                {
                    var otherMember = GetOtherDirectMember();
                    if (otherMember is not null && onlineMemberIds.Contains(otherMember.UserId))
                    {
                        <span>● online</span>
                    }
                    else
                    {
                        <span>○ offline</span>
                    }
                }
                else
                {
                    <text>@openedChat.Type · @openedChat.Members.Count(m => m.Status == MemberStatus.Active) active</text>
                    if (onlineMemberIds.Count > 0)
                    {
                        <span> · @onlineMemberIds.Count online</span>
                    }
                    <text> · you are @currentUserRole</text>
                }
            </MudText>
            <div style="min-height:1.2em">
                @if (BuildTypingNames() is { Length: > 0 } typingNames)
                {
                    <MudText Typo="Typo.caption" Color="Color.Primary" Class="fst-italic">@typingNames typing…</MudText>
                }
            </div>
        </div>
        <div class="d-flex align-center" style="gap:8px">
            <MudButton OnClick="ToggleManagePanel" Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Settings">Manage</MudButton>
            <MudButton Href="chats" Variant="Variant.Outlined" Size="Size.Small">All chats</MudButton>
        </div>
    </div>

    @if (showManagePanel)
    {
        <MudCard Elevation="2" Class="mb-3">
            <MudCardContent>
                <MudText Typo="Typo.h6" GutterBottom="true">Manage chat</MudText>
                @if (!string.IsNullOrEmpty(manageActionError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@manageActionError</MudAlert>
                }

                @if (openedChat.Type != ChatType.Direct && currentUserIsModerator)
                {
                    <div class="d-flex align-center mb-3" style="gap:8px;max-width:420px">
                        <MudTextField @bind-Value="renameChatValue" Label="Rename" Placeholder="@openedChat.Name"
                                      Variant="Variant.Outlined" Immediate="true" Class="flex-grow-1" />
                        <MudButton OnClick="RenameChatAsync" Variant="Variant.Filled" Color="Color.Primary"
                                   Disabled="isManageActionRunning">Save</MudButton>
                    </div>
                }

                <MudText Typo="Typo.subtitle2" GutterBottom="true">Members</MudText>
                <MudList T="string" Class="pa-0 mb-3">
                    @foreach (var member in openedChat.Members.OrderBy(m => m.Role))
                    {
                        var roleToggle = GetRoleToggle(member);
                        var canKickMember = currentUserIsModerator
                            && openedChat.Type != ChatType.Direct
                            && member.Status == MemberStatus.Active
                            && member.UserId != currentUserId
                            && member.Role != MemberRole.Owner;
                        var canTransferOwnership = currentUserRole == MemberRole.Owner
                            && openedChat.Type != ChatType.Direct
                            && member.Status == MemberStatus.Active
                            && member.UserId != currentUserId
                            && member.Role != MemberRole.Owner;

                        <MudListItem T="string">
                            <div class="d-flex align-center justify-space-between" style="width:100%">
                                <div class="d-flex align-center" style="gap:6px">
                                    <MudText Typo="Typo.body2"
                                             Style="@(member.Status != MemberStatus.Active ? "opacity:.6" : "")">
                                        @Usernames.Get(member.UserId)
                                        @if (member.UserId == currentUserId) { <span>(you)</span> }
                                    </MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@member.Role</MudChip>
                                    @if (member.Status != MemberStatus.Active)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">@member.Status</MudChip>
                                    }
                                </div>
                                <div class="d-flex align-center" style="gap:6px">
                                    @if (roleToggle is not null && currentUserIsModerator
                                        && member.Status == MemberStatus.Active && member.UserId != currentUserId)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                   OnClick="() => ChangeMemberRoleAsync(member.UserId, roleToggle.Value.TargetRole)"
                                                   Disabled="isManageActionRunning">@roleToggle.Value.Label</MudButton>
                                    }
                                    @if (canTransferOwnership)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                                   OnClick="() => TransferOwnershipAsync(member.UserId)"
                                                   Disabled="isManageActionRunning">Make owner</MudButton>
                                    }
                                    @if (canKickMember)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                                   OnClick="() => KickMemberAsync(member.UserId)"
                                                   Disabled="isManageActionRunning">Kick</MudButton>
                                    }
                                </div>
                            </div>
                        </MudListItem>
                    }
                </MudList>

                @if (openedChat.Type != ChatType.Direct)
                {
                    <MudButton OnClick="LeaveChatAsync" Variant="Variant.Outlined" Color="Color.Error"
                               Size="Size.Small" Disabled="isManageActionRunning"
                               StartIcon="@Icons.Material.Filled.ExitToApp">Leave chat</MudButton>
                }
            </MudCardContent>
        </MudCard>
    }

    <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3" Style="height:50vh;overflow-y:auto"
              aria-live="polite" aria-relevant="additions" aria-label="Messages">
        @if (olderMessagesCursor is not null)
        {
            <div class="d-flex justify-center mb-2">
                <MudButton OnClick="LoadOlderMessagesAsync" Variant="Variant.Text" Size="Size.Small">Load older</MudButton>
            </div>
        }
        @foreach (var message in messages)
        {
            var sentByCurrentUser = message.AuthorId == currentUserId;
            var repliedToMessage = FindRepliedToMessage(message);
            <div class="d-flex mb-2 @(sentByCurrentUser ? "justify-end" : "justify-start")">
                <MudPaper Elevation="1" Class="pa-2 px-3"
                          Style="@($"max-width:70%;{(sentByCurrentUser ? "background:var(--mud-palette-primary);color:var(--mud-palette-primary-text)" : "")}")">
                    <MudText Typo="Typo.caption" Style="@(sentByCurrentUser ? "opacity:.8" : "opacity:.6")">
                        @(sentByCurrentUser ? "you" : Usernames.Get(message.AuthorId)) · @message.SentAt.ToLocalTime().ToString("HH:mm")
                        @if (message.ForwardOriginalMessageId is not null)
                        {
                            <span class="fst-italic"> · forwarded</span>
                        }
                    </MudText>

                    @if (repliedToMessage is not null)
                    {
                        <MudText Typo="Typo.caption" Class="pl-2 my-1"
                                 Style="border-left:2px solid currentColor;opacity:.85;display:block">
                            ↪ @(sentByCurrentUser ? "" : Usernames.Get(repliedToMessage.AuthorId) + ": ")@BuildShortMessagePreview(repliedToMessage)
                        </MudText>
                    }

                    @if (message.IsRetracted)
                    {
                        <MudText Class="fst-italic" Style="opacity:.7">[retracted]</MudText>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(message.Text))
                        {
                            <MudText Typo="Typo.body2" Style="white-space:pre-wrap">@message.Text</MudText>
                        }
                        @foreach (var attachment in message.Attachments)
                        {
                            @if (attachment.Type == AttachmentType.Image)
                            {
                                <MudImage Src="@attachment.Url" Alt="@(attachment.FileName ?? "image")"
                                          Fluid="true" Class="rounded mt-1" Style="max-height:220px" />
                            }
                            else
                            {
                                <MudLink Href="@attachment.Url" Target="_blank" Class="d-block mt-1">
                                    📎 @(attachment.FileName ?? attachment.Url)
                                </MudLink>
                            }
                        }
                        @if (message.Reactions.Count > 0)
                        {
                            <div class="d-flex flex-wrap mt-1" style="gap:4px">
                                @foreach (var reactionGroup in message.Reactions.GroupBy(r => r.Emoji))
                                {
                                    var reactedByCurrentUser = reactionGroup.Any(r => r.UserId == currentUserId);
                                    <MudButton Size="Size.Small" Class="pa-1"
                                               Variant="@(reactedByCurrentUser ? Variant.Filled : Variant.Outlined)"
                                               aria-label="@($"{reactionGroup.Key} reaction, {reactionGroup.Count()}{(reactedByCurrentUser ? ", added by you — click to remove" : " — click to add")}")"
                                               OnClick="() => ToggleReactionAsync(message, reactionGroup.Key)">
                                        @GetReactionGlyph(reactionGroup.Key) @reactionGroup.Count()
                                    </MudButton>
                                }
                            </div>
                        }
                        @if (openedChat.Type == ChatType.Broadcast && sentByCurrentUser && message.BroadcastReadCount is > 0)
                        {
                            <MudText Typo="Typo.caption" Style="opacity:.8" Class="mt-1">👁 @message.BroadcastReadCount read</MudText>
                        }
                        <div class="d-flex align-center mt-1">
                            <MudTooltip Text="React">
                                <MudIconButton Icon="@Icons.Material.Filled.AddReaction" Size="Size.Small"
                                               OnClick="() => ToggleReactionPicker(message.MessageId)" aria-label="React" />
                            </MudTooltip>
                            <MudTooltip Text="Reply">
                                <MudIconButton Icon="@Icons.Material.Filled.Reply" Size="Size.Small"
                                               OnClick="() => StartReplyingTo(message)" aria-label="Reply" />
                            </MudTooltip>
                            <MudTooltip Text="Forward">
                                <MudIconButton Icon="@Icons.Material.Filled.Forward" Size="Size.Small"
                                               OnClick="() => OpenForwardDialogAsync(message)" aria-label="Forward" />
                            </MudTooltip>
                            <MudTooltip Text="Hide for me">
                                <MudIconButton Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Small"
                                               OnClick="() => HideMessageAsync(message)" aria-label="Hide" />
                            </MudTooltip>
                            @if (sentByCurrentUser || currentUserIsModerator)
                            {
                                <MudTooltip Text="Retract for everyone">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   OnClick="() => RetractMessageAsync(message)" aria-label="Retract" />
                                </MudTooltip>
                            }
                        </div>
                        @if (reactionPickerMessageId == message.MessageId)
                        {
                            <div class="d-flex flex-wrap mt-1" style="gap:4px">
                                @foreach (var emoji in Enum.GetValues<ReactionEmoji>())
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="pa-1"
                                               aria-label="@emoji.ToString()"
                                               OnClick="() => ToggleReactionAsync(message, emoji)">@GetReactionGlyph(emoji)</MudButton>
                                }
                            </div>
                        }
                    }
                </MudPaper>
            </div>
        }
    </MudPaper>

    @if (messageBeingRepliedTo is not null)
    {
        <MudPaper Outlined="true" Elevation="0" Class="d-flex align-center justify-space-between px-3 py-1 mb-1">
            <MudText Typo="Typo.caption">
                ↪ Replying to @Usernames.Get(messageBeingRepliedTo.AuthorId): @BuildShortMessagePreview(messageBeingRepliedTo)
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CancelReply"
                           aria-label="Cancel reply" />
        </MudPaper>
    }

    @if (stagedAttachments.Count > 0)
    {
        <div class="d-flex flex-wrap mb-1" style="gap:6px">
            @for (var index = 0; index < stagedAttachments.Count; index++)
            {
                var attachmentIndex = index;
                var attachment = stagedAttachments[index];
                <MudChip T="string" Size="Size.Small" Color="Color.Default"
                         OnClose="() => RemoveStagedAttachment(attachmentIndex)">
                    @attachment.Type: @(attachment.FileName ?? attachment.Url)
                </MudChip>
            }
        </div>
    }

    <div class="d-flex align-center" style="gap:8px">
        <MudTooltip Text="Add attachment">
            <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                           OnClick="() => showAttachmentComposer = !showAttachmentComposer"
                           aria-label="Add attachment" />
        </MudTooltip>
        <MudTextField @bind-Value="messageDraft" @bind-Value:after="OnComposerChangedAsync"
                      Placeholder="Type a message…" Variant="Variant.Outlined" Immediate="true"
                      Class="flex-grow-1" OnKeyDown="SendOnEnterAsync" />
        <MudButton OnClick="SendMessageAsync" Variant="Variant.Filled" Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.Send"
                   Disabled="@(isSendingMessage || (string.IsNullOrWhiteSpace(messageDraft) && stagedAttachments.Count == 0))">
            @(isSendingMessage ? "…" : "Send")
        </MudButton>
    </div>

    @if (showAttachmentComposer)
    {
        <MudCard Elevation="1" Class="mt-2">
            <MudCardContent>
                <div class="d-flex flex-wrap align-end" style="gap:12px">
                    <MudSelect T="AttachmentType" @bind-Value="attachmentDraft.Type" Label="Type"
                               Variant="Variant.Outlined" Dense="true" Style="min-width:120px">
                        @foreach (var attachmentType in Enum.GetValues<AttachmentType>())
                        {
                            <MudSelectItem Value="attachmentType">@attachmentType</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="attachmentDraft.Url" Label="URL" Placeholder="https://…"
                                  Variant="Variant.Outlined" Class="flex-grow-1" />
                    <MudTextField @bind-Value="attachmentDraft.FileName" Label="File name (optional)"
                                  Variant="Variant.Outlined" Class="flex-grow-1" />
                    <MudTextField @bind-Value="attachmentDraft.SizeBytes" Label="Size (bytes)"
                                  Variant="Variant.Outlined" Style="width:120px" />
                    <MudButton OnClick="AddStagedAttachment" Variant="Variant.Outlined" Color="Color.Primary">Attach</MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }

    @if (actionError is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@actionError</MudAlert>
    }
}

<MudDialog Visible="messageBeingForwarded is not null" VisibleChanged="OnForwardDialogVisibleChanged"
           Options="new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>Forward to…</TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(forwardError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@forwardError</MudAlert>
        }
        @if (forwardTargetChats is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (forwardTargetChats.Count == 0)
        {
            <MudText Color="Color.Secondary">No other chats to forward to.</MudText>
        }
        else
        {
            <MudList T="string" Class="pa-0">
                @foreach (var targetChat in forwardTargetChats)
                {
                    <MudListItem T="string">
                        <div class="d-flex align-center justify-space-between" style="width:100%">
                            <div class="d-flex align-center" style="gap:6px">
                                <MudText Typo="Typo.body2">@(targetChat.Name ?? "(direct)")</MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@targetChat.Type</MudChip>
                            </div>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="() => ForwardMessageToChatAsync(targetChat.ChatId)"
                                       Disabled="isForwarding">Forward</MudButton>
                        </div>
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public Guid ChatId { get; set; }

    private Guid currentUserId;
    private ChatDetails? openedChat;
    private readonly List<ChatMessage> messages = [];
    private DateTime? olderMessagesCursor;
    private string messageDraft = "";
    private string? actionError;
    private string? chatLoadError;
    private bool isSendingMessage;
    private DateTime lastTypingSignalSentAt = DateTime.MinValue;
    private readonly HashSet<Guid> onlineMemberIds = [];
    private readonly Dictionary<Guid, DateTime> typingExpiryByUser = [];
    private Timer? typingSweepTimer;
    private Guid? reactionPickerMessageId;

    // What the current user is allowed to do in this chat.
    private bool currentUserIsModerator;
    private MemberRole? currentUserRole;

    // Reply.
    private ChatMessage? messageBeingRepliedTo;

    // Forward dialog.
    private ChatMessage? messageBeingForwarded;
    private IReadOnlyList<ChatSummary>? forwardTargetChats;
    private bool isForwarding;
    private string? forwardError;

    // Attachment composer.
    private bool showAttachmentComposer;
    private readonly List<OutgoingAttachment> stagedAttachments = new();
    private AttachmentDraft attachmentDraft = new();

    // Management panel.
    private bool showManagePanel;
    private string? renameChatValue;
    private bool isManageActionRunning;
    private string? manageActionError;

    protected override async Task OnInitializedAsync()
    {
        if (Session.UserId is not { } userId)
        {
            Navigation.NavigateTo("/");
            return;
        }
        currentUserId = userId;

        Realtime.MessageSent += OnMessageSentPush;
        Realtime.MessageRetracted += OnMessageRetractedPush;
        Realtime.ReactionAdded += OnReactionChangedPush;
        Realtime.ReactionRemoved += OnReactionChangedPush;
        Realtime.UserTyping += OnUserTypingPush;
        Realtime.PresenceChanged += OnPresenceChangedPush;

        // Core load: the chat itself. A failure here leaves the page in an
        // error state rather than an eternal spinner.
        try
        {
            openedChat = await ChatsApi.GetChatByIdAsync(currentUserId, ChatId);
        }
        catch (Exception ex)
        {
            chatLoadError = ex.Message;
            return;
        }
        if (openedChat is null)
        {
            chatLoadError = "Chat not found, or you no longer have access to it.";
            return;
        }

        // Core load: the message history.
        try
        {
            var page = await MessagingApi.GetChatMessagesAsync(currentUserId, ChatId, pageSize: 50);
            messages.AddRange(page.Items.Reverse());
            olderMessagesCursor = page.NextCursor;
        }
        catch (Exception ex)
        {
            chatLoadError = ex.Message;
            return;
        }

        var memberIds = openedChat.Members.Select(m => m.UserId).ToList();

        // Everything below is cosmetic/enrichment — a transient failure of any
        // one of these must not abort the whole render.
        try { await Usernames.EnsureAsync(memberIds.Append(currentUserId)); }
        catch { /* names fall back to short ids */ }

        try
        {
            var presenceByUser = await PresenceApi.GetBatchPresenceAsync(currentUserId, memberIds);
            foreach (var (memberId, isOnline) in presenceByUser)
                if (isOnline) onlineMemberIds.Add(memberId);
        }
        catch { /* online indicator just stays empty */ }

        currentUserRole = openedChat.Members
            .FirstOrDefault(m => m.UserId == currentUserId && m.Status == MemberStatus.Active)?.Role;
        try { currentUserIsModerator = await ChatsApi.IsModeratorAsync(currentUserId, ChatId, currentUserId); }
        catch { currentUserIsModerator = false; }

        try
        {
            // The SDK records the join intent and (re)connects as needed, so this is
            // safe to call even if the hub isn't up yet — no IsConnected guard required.
            await Realtime.JoinChatAsync(ChatId);
        }
        catch { /* live updates degrade to manual refresh */ }

        try { await NotificationsApi.MarkChatAsReadAsync(currentUserId, ChatId); }
        catch { /* best-effort */ }

        // Typing indicators expire client-side (5s TTL, matching the server's Redis TTL).
        typingSweepTimer = new Timer(_ => _ = InvokeAsync(() =>
        {
            var now = DateTime.UtcNow;
            var expiredUserIds = typingExpiryByUser.Where(kv => kv.Value < now).Select(kv => kv.Key).ToList();
            if (expiredUserIds.Count == 0) return;
            foreach (var userId2 in expiredUserIds) typingExpiryByUser.Remove(userId2);
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private ChatMember? GetOtherDirectMember() =>
        openedChat?.Members.FirstOrDefault(m => m.UserId != currentUserId);

    private string GetChatTitle()
    {
        if (openedChat is null) return "Chat";
        if (openedChat.Type == ChatType.Direct)
        {
            var otherMember = GetOtherDirectMember();
            return otherMember is not null ? Usernames.Get(otherMember.UserId) : "Direct chat";
        }
        return openedChat.Name ?? "Chat";
    }

    private string BuildTypingNames()
        => string.Join(", ", typingExpiryByUser.Keys.Where(id => id != currentUserId).Select(Usernames.Get));

    private static string GetReactionGlyph(ReactionEmoji emoji) => emoji switch
    {
        ReactionEmoji.Like => "👍",
        ReactionEmoji.Heart => "❤️",
        ReactionEmoji.Laugh => "😂",
        ReactionEmoji.Wow => "😮",
        ReactionEmoji.Sad => "😢",
        ReactionEmoji.Angry => "😠",
        ReactionEmoji.Fire => "🔥",
        ReactionEmoji.Dislike => "👎",
        _ => emoji.ToString()
    };

    private string BuildShortMessagePreview(ChatMessage message)
    {
        if (message.IsRetracted) return "[retracted]";
        if (!string.IsNullOrWhiteSpace(message.Text))
            return message.Text!.Length > 60 ? message.Text[..60] + "…" : message.Text;
        if (message.Attachments.Count > 0) return $"[{message.Attachments[0].Type.ToString().ToLowerInvariant()}]";
        return "[message]";
    }

    // ---- realtime handlers (background threads → InvokeAsync) ----

    private void OnMessageSentPush(MessageSentPush push)
    {
        if (push.ChatId != ChatId || push.AuthorId == currentUserId) return;
        _ = InvokeAsync(async () =>
        {
            var newMessage = await MessagingApi.GetMessageByIdAsync(currentUserId, push.MessageId);
            if (newMessage is null || messages.Any(m => m.MessageId == newMessage.MessageId)) return;
            await Usernames.EnsureAsync([newMessage.AuthorId]);
            messages.Add(newMessage);
            typingExpiryByUser.Remove(newMessage.AuthorId);
            try { await NotificationsApi.MarkChatAsReadAsync(currentUserId, ChatId); } catch { /* best-effort */ }
            StateHasChanged();
        });
    }

    private void OnMessageRetractedPush(MessageRetractedPush push)
    {
        if (push.ChatId != ChatId) return;
        _ = InvokeAsync(() => RefreshSingleMessageAsync(push.MessageId));
    }

    private void OnReactionChangedPush(ReactionPush push)
    {
        if (push.ChatId != ChatId) return;
        _ = InvokeAsync(() => RefreshSingleMessageAsync(push.MessageId));
    }

    private async Task RefreshSingleMessageAsync(Guid messageId)
    {
        var freshMessage = await MessagingApi.GetMessageByIdAsync(currentUserId, messageId);
        var messageIndex = messages.FindIndex(m => m.MessageId == messageId);
        if (freshMessage is not null && messageIndex >= 0)
        {
            messages[messageIndex] = freshMessage;
            StateHasChanged();
        }
    }

    private void OnUserTypingPush(UserTypingPush push)
    {
        if (push.ChatId != ChatId || push.UserId == currentUserId) return;
        _ = InvokeAsync(() =>
        {
            typingExpiryByUser[push.UserId] = DateTime.UtcNow.AddSeconds(5);
            StateHasChanged();
        });
    }

    private void OnPresenceChangedPush(PresencePush push)
    {
        // Presence pushes are broadcast to every user sharing any chat with the
        // subject, not just this chat's members — ignore anyone not in it, or the
        // online count would be inflated by unrelated users.
        if (openedChat is null || !openedChat.Members.Any(m => m.UserId == push.UserId)) return;
        _ = InvokeAsync(() =>
        {
            if (push.IsOnline) onlineMemberIds.Add(push.UserId); else onlineMemberIds.Remove(push.UserId);
            StateHasChanged();
        });
    }

    // ---- actions ----

    private async Task OnComposerChangedAsync()
    {
        // Throttle like the Web BFF: at most one StartTyping per 2s (server TTL is 5s).
        if (DateTime.UtcNow - lastTypingSignalSentAt < TimeSpan.FromSeconds(2)) return;
        lastTypingSignalSentAt = DateTime.UtcNow;
        try { await PresenceApi.StartTypingAsync(currentUserId, ChatId); } catch { /* cosmetic */ }
    }

    private Task SendOnEnterAsync(KeyboardEventArgs args)
        => args.Key is "Enter" or "NumpadEnter" && !args.ShiftKey ? SendMessageAsync() : Task.CompletedTask;

    private async Task SendMessageAsync()
    {
        if ((string.IsNullOrWhiteSpace(messageDraft) && stagedAttachments.Count == 0) || openedChat is null) return;
        actionError = null;
        isSendingMessage = true;
        try
        {
            // BFF-style enrichment, done client-side by the SDK helpers.
            var recipientIds = await ChatsApi.GetActiveRecipientsAsync(currentUserId, ChatId, currentUserId);
            var isBroadcastChat = openedChat.Type == ChatType.Broadcast;
            var sentMessageId = await MessagingApi.SendMessageAsync(
                currentUserId,
                ChatId,
                string.IsNullOrWhiteSpace(messageDraft) ? null : messageDraft.Trim(),
                recipientIds,
                isBroadcastChat,
                attachments: stagedAttachments.Count > 0 ? stagedAttachments.ToList() : null,
                replyToMessageId: messageBeingRepliedTo?.MessageId);

            messageDraft = "";
            stagedAttachments.Clear();
            messageBeingRepliedTo = null;
            showAttachmentComposer = false;

            var sentMessage = await MessagingApi.GetMessageByIdAsync(currentUserId, sentMessageId);
            if (sentMessage is not null && !messages.Any(m => m.MessageId == sentMessage.MessageId))
                messages.Add(sentMessage);
        }
        catch (Exception ex)
        {
            actionError = ex.Message;
        }
        finally
        {
            isSendingMessage = false;
        }

        // Stop lingering as "typing…" for the recipient(s) now that the message landed,
        // rather than waiting out the server's 5s TTL.
        try { await PresenceApi.StopTypingAsync(currentUserId, ChatId); } catch { /* cosmetic */ }
    }

    private void ToggleReactionPicker(Guid messageId)
        => reactionPickerMessageId = reactionPickerMessageId == messageId ? null : messageId;

    private async Task ToggleReactionAsync(ChatMessage message, ReactionEmoji emoji)
    {
        try
        {
            var alreadyReactedWithEmoji = message.Reactions.Any(r => r.UserId == currentUserId && r.Emoji == emoji);
            if (alreadyReactedWithEmoji)
                await MessagingApi.RemoveReactionAsync(currentUserId, message.MessageId, emoji);
            else
                await MessagingApi.AddReactionAsync(currentUserId, message.MessageId, emoji);
            reactionPickerMessageId = null;
            await RefreshSingleMessageAsync(message.MessageId);
        }
        catch (Exception ex) { actionError = ex.Message; }
    }

    // ---- Reply ----

    private void StartReplyingTo(ChatMessage message) => messageBeingRepliedTo = message;
    private void CancelReply() => messageBeingRepliedTo = null;

    private ChatMessage? FindRepliedToMessage(ChatMessage message)
        => message.ReplyToMessageId is null
            ? null
            : messages.FirstOrDefault(m => m.MessageId == message.ReplyToMessageId);

    // ---- Retract / Hide ----

    private async Task RetractMessageAsync(ChatMessage message)
    {
        try
        {
            await MessagingApi.RetractMessageAsync(currentUserId, message.MessageId, currentUserIsModerator);
            await RefreshSingleMessageAsync(message.MessageId);
        }
        catch (Exception ex) { actionError = ex.Message; }
    }

    private async Task HideMessageAsync(ChatMessage message)
    {
        try
        {
            await MessagingApi.HideMessageAsync(currentUserId, message.MessageId);
            messages.RemoveAll(m => m.MessageId == message.MessageId);
            StateHasChanged();
        }
        catch (Exception ex) { actionError = ex.Message; }
    }

    // ---- Forward ----

    private async Task OpenForwardDialogAsync(ChatMessage message)
    {
        messageBeingForwarded = message;
        forwardError = null;
        forwardTargetChats = null;
        StateHasChanged();
        try
        {
            var allChats = await ChatsApi.GetMyChatsAsync(currentUserId);
            forwardTargetChats = allChats.Where(c => c.ChatId != ChatId).ToList();
        }
        catch (Exception ex) { forwardError = ex.Message; }
    }

    private void OnForwardDialogVisibleChanged(bool visible)
    {
        if (!visible) CloseForwardDialog();
    }

    private void CloseForwardDialog()
    {
        messageBeingForwarded = null;
        forwardTargetChats = null;
        forwardError = null;
    }

    private async Task ForwardMessageToChatAsync(Guid targetChatId)
    {
        if (messageBeingForwarded is null) return;
        forwardError = null;
        isForwarding = true;
        try
        {
            var recipientIds = await ChatsApi.GetActiveRecipientsAsync(currentUserId, targetChatId, currentUserId);
            var targetChatType = await ChatsApi.GetChatTypeAsync(currentUserId, targetChatId);

            await MessagingApi.SendMessageAsync(
                authorUserId: currentUserId,
                chatId: targetChatId,
                text: messageBeingForwarded.Text,
                recipients: recipientIds,
                isBroadcast: targetChatType == ChatType.Broadcast,
                attachments: messageBeingForwarded.Attachments
                    .Select(a => new OutgoingAttachment(a.Type, a.Url, a.SizeBytes, a.FileName))
                    .ToList(),
                forwardOriginalMessageId: messageBeingForwarded.MessageId,
                forwardOriginalChatId: ChatId);

            CloseForwardDialog();
            Navigation.NavigateTo($"/chat/{targetChatId}");
        }
        catch (Exception ex) { forwardError = ex.Message; }
        finally { isForwarding = false; }
    }

    // ---- Attachments composer ----

    private void AddStagedAttachment()
    {
        if (string.IsNullOrWhiteSpace(attachmentDraft.Url)) { actionError = "Attachment URL is required."; return; }
        var sizeBytes = attachmentDraft.SizeBytes <= 0 ? 1 : attachmentDraft.SizeBytes;
        stagedAttachments.Add(new OutgoingAttachment(
            attachmentDraft.Type,
            attachmentDraft.Url.Trim(),
            sizeBytes,
            string.IsNullOrWhiteSpace(attachmentDraft.FileName) ? null : attachmentDraft.FileName!.Trim()));
        attachmentDraft = new AttachmentDraft();
    }

    private void RemoveStagedAttachment(int index)
    {
        if (index >= 0 && index < stagedAttachments.Count) stagedAttachments.RemoveAt(index);
    }

    // ---- Management panel ----

    private void ToggleManagePanel()
    {
        showManagePanel = !showManagePanel;
        manageActionError = null;
        if (showManagePanel) renameChatValue = openedChat?.Name;
    }

    private async Task ReloadChatDetailsAsync()
    {
        try
        {
            openedChat = await ChatsApi.GetChatByIdAsync(currentUserId, ChatId);
            if (openedChat is not null)
            {
                currentUserRole = openedChat.Members
                    .FirstOrDefault(m => m.UserId == currentUserId && m.Status == MemberStatus.Active)?.Role;
                await Usernames.EnsureAsync(openedChat.Members.Select(m => m.UserId));
            }
        }
        catch { /* keep last good state */ }
        StateHasChanged();
    }

    private async Task RenameChatAsync()
    {
        if (string.IsNullOrWhiteSpace(renameChatValue)) { manageActionError = "Name is required."; return; }
        manageActionError = null;
        isManageActionRunning = true;
        try
        {
            await ChatsApi.RenameChatAsync(currentUserId, ChatId, renameChatValue.Trim());
            await ReloadChatDetailsAsync();
        }
        catch (Exception ex) { manageActionError = ex.Message; }
        finally { isManageActionRunning = false; }
    }

