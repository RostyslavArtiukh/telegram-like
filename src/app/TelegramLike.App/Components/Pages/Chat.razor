@page "/chat/{ChatId:guid}"
@implements IAsyncDisposable
@inject TelegramLikeSession Session
@inject IChatsApi ChatsApi
@inject IMessagingApi MessagingApi
@inject IPresenceApi PresenceApi
@inject INotificationsApi NotificationsApi
@inject IIdentityUsersApi IdentityUsers
@inject UsernameCache Usernames
@inject ITelegramLikeRealtimeClient Realtime
@inject NavigationManager Nav

@if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
    <a href="chats" class="btn btn-link">← Back to chats</a>
}
else if (_chat is null)
{
    <p>Loading…</p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
            <h1 class="h3 mb-1">@ChatTitle()</h1>
            <div class="text-muted small">
                @if (_chat.Type == ChatTypeContract.Direct)
                {
                    var peer = OtherDirectMember();
                    if (peer is not null && _online.Contains(peer.UserId))
                    {
                        <span class="text-success">● online</span>
                    }
                    else
                    {
                        <span>○ offline</span>
                    }
                }
                else
                {
                    <text>@_chat.Type · @_chat.Members.Count(m => m.Status == MemberStatusContract.Active) active</text>
                    if (_online.Count > 0)
                    {
                        <span class="text-success"> · @_online.Count online</span>
                    }
                    <text> · you are @_myRole</text>
                }
            </div>
            <div class="small fst-italic" style="min-height: 1.2em">
                @if (TypingNames() is { Length: > 0 } typing)
                {
                    <span class="text-primary">@typing typing…</span>
                }
            </div>
        </div>
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn btn-outline-secondary" @onclick="ToggleManage">Manage</button>
            <a href="chats" class="btn btn-outline-secondary">All chats</a>
        </div>
    </div>

    @if (_showManage)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h5 card-title">Manage chat</h2>
                @if (!string.IsNullOrEmpty(_actionError))
                {
                    <div class="alert alert-danger">@_actionError</div>
                }

                @if (_chat.Type != ChatTypeContract.Direct && _isModerator)
                {
                    <div class="input-group input-group-sm mb-3" style="max-width: 420px;">
                        <span class="input-group-text">Rename</span>
                        <input class="form-control" @bind="_renameValue" placeholder="@_chat.Name" />
                        <button type="button" class="btn btn-outline-primary" @onclick="RenameAsync" disabled="@_busyManage">Save</button>
                    </div>
                }

                <h3 class="h6">Members</h3>
                <ul class="list-group mb-3">
                    @foreach (var member in _chat.Members.OrderBy(m => m.Role))
                    {
                        var toggle = RoleToggle(member);
                        var canKick = _isModerator
                            && _chat.Type != ChatTypeContract.Direct
                            && member.Status == MemberStatusContract.Active
                            && member.UserId != _me
                            && member.Role != MemberRoleContract.Owner;
                        var canTransfer = _myRole == MemberRoleContract.Owner
                            && _chat.Type != ChatTypeContract.Direct
                            && member.Status == MemberStatusContract.Active
                            && member.UserId != _me
                            && member.Role != MemberRoleContract.Owner;

                        <li class="list-group-item d-flex justify-content-between align-items-center
                                   @(member.Status != MemberStatusContract.Active ? "text-muted" : "")">
                            <div>
                                @Usernames.Get(member.UserId)
                                @if (member.UserId == _me) { <span class="text-muted">(you)</span> }
                                <span class="badge bg-light text-dark ms-1">@member.Role</span>
                                @if (member.Status != MemberStatusContract.Active)
                                {
                                    <span class="badge bg-secondary ms-1">@member.Status</span>
                                }
                            </div>
                            <div class="btn-group btn-group-sm">
                                @if (toggle is not null && _isModerator && member.Status == MemberStatusContract.Active && member.UserId != _me)
                                {
                                    <button type="button" class="btn btn-outline-secondary"
                                            @onclick="() => ChangeRoleAsync(member.UserId, toggle.Value.Target)"
                                            disabled="@_busyManage">
                                        @toggle.Value.Label
                                    </button>
                                }
                                @if (canTransfer)
                                {
                                    <button type="button" class="btn btn-outline-warning"
                                            @onclick="() => TransferAsync(member.UserId)" disabled="@_busyManage">
                                        Make owner
                                    </button>
                                }
                                @if (canKick)
                                {
                                    <button type="button" class="btn btn-outline-danger"
                                            @onclick="() => KickAsync(member.UserId)" disabled="@_busyManage">
                                        Kick
                                    </button>
                                }
                            </div>
                        </li>
                    }
                </ul>

                @if (_chat.Type != ChatTypeContract.Direct)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="LeaveAsync" disabled="@_busyManage">
                        Leave chat
                    </button>
                }
            </div>
        </div>
    }

    <div class="border rounded p-3 mb-3" style="height: 50vh; overflow-y: auto; background: #f8f9fa"
         aria-live="polite" aria-relevant="additions" aria-label="Messages">
        @if (_older is not null)
        {
            <div class="text-center mb-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadOlderAsync">Load older</button>
            </div>
        }
        @foreach (var m in _messages)
        {
            var mine = m.AuthorId == _me;
            var reply = ReplyPreviewFor(m);
            <div class="d-flex @(mine ? "justify-content-end" : "justify-content-start") mb-2">
                <div class="rounded p-2 @(mine ? "bg-primary text-white" : "bg-white border")" style="max-width: 70%">
                    <div class="small @(mine ? "text-white-50" : "text-muted")">
                        @(mine ? "you" : Usernames.Get(m.AuthorId)) · @m.SentAt.ToLocalTime().ToString("HH:mm")
                        @if (m.ForwardOriginalMessageId is not null)
                        {
                            <span class="fst-italic"> · forwarded</span>
                        }
                    </div>

                    @if (reply is not null)
                    {
                        <div class="border-start ps-2 my-1 small @(mine ? "border-light" : "border-secondary")" style="opacity:.85;">
                            ↪ @(mine ? "" : Usernames.Get(reply.AuthorId) + ": ")@Snippet(reply)
                        </div>
                    }

                    @if (m.IsRetracted)
                    {
                        <em class="@(mine ? "text-white-50" : "text-muted")">[retracted]</em>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(m.Text))
                        {
                            <div>@m.Text</div>
                        }
                        @foreach (var a in m.Attachments)
                        {
                            @if (a.Type == AttachmentTypeContract.Image)
                            {
                                <img src="@a.Url" alt="@(a.FileName ?? "image")" class="img-fluid rounded mt-1" style="max-height: 220px;" />
                            }
                            else
                            {
                                <a href="@a.Url" target="_blank" class="d-block mt-1 @(mine ? "text-white" : "")">
                                    📎 @(a.FileName ?? a.Url)
                                </a>
                            }
                        }
                        @if (m.Reactions.Count > 0)
                        {
                            <div class="small mt-1">
                                @foreach (var g in m.Reactions.GroupBy(r => r.Emoji))
                                {
                                    var picked = g.Any(r => r.UserId == _me);
                                    <button type="button" class="btn btn-sm py-0 px-1 me-1 @(picked ? "btn-light border" : "btn-outline-light border")"
                                            style="@(mine ? "" : "color:#333;")"
                                            aria-label="@($"{g.Key} reaction, {g.Count()}{(picked ? ", added by you — click to remove" : " — click to add")}")"
                                            @onclick="() => ToggleReactionAsync(m, g.Key)">
                                        @Glyph(g.Key) @g.Count()
                                    </button>
                                }
                            </div>
                        }
                        @if (_chat.Type == ChatTypeContract.Broadcast && mine && m.BroadcastReadCount is > 0)
                        {
                            <div class="small text-white-50 mt-1">👁 @m.BroadcastReadCount read</div>
                        }
                        <div class="small mt-1">
                            <button type="button" class="btn btn-link btn-sm p-0 align-baseline @(mine ? "text-white-50" : "")"
                                    @onclick="() => ToggleReactPicker(m.MessageId)">react</button>
                            <span class="@(mine ? "text-white-50" : "")"> · </span>
                            <button type="button" class="btn btn-link btn-sm p-0 align-baseline @(mine ? "text-white-50" : "")"
                                    @onclick="() => SetReply(m)">reply</button>
                            <span class="@(mine ? "text-white-50" : "")"> · </span>
                            <button type="button" class="btn btn-link btn-sm p-0 align-baseline @(mine ? "text-white-50" : "")"
                                    @onclick="() => OpenForwardAsync(m)">forward</button>
                            <span class="@(mine ? "text-white-50" : "")"> · </span>
                            <button type="button" class="btn btn-link btn-sm p-0 align-baseline @(mine ? "text-white-50" : "")"
                                    @onclick="() => HideAsync(m)">hide</button>
                            @if (mine || _isModerator)
                            {
                                <span class="@(mine ? "text-white-50" : "")"> · </span>
                                <button type="button" class="btn btn-link btn-sm p-0 align-baseline @(mine ? "text-white-50" : "")"
                                        @onclick="() => RetractAsync(m)">retract</button>
                            }
                        </div>
                        @if (_reactPickerFor == m.MessageId)
                        {
                            <div class="small mt-1">
                                @foreach (var emoji in Enum.GetValues<EmojiContract>())
                                {
                                    var picked = m.Reactions.Any(r => r.UserId == _me && r.Emoji == emoji);
                                    <button type="button" class="btn btn-sm py-0 px-1 me-1 @(picked ? "btn-light border" : "btn-outline-light border")"
                                            aria-label="@emoji.ToString()"
                                            @onclick="() => ToggleReactionAsync(m, emoji)">@Glyph(emoji)</button>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>

    @if (_replyTo is not null)
    {
        <div class="d-flex justify-content-between align-items-center bg-light border rounded px-3 py-1 mb-1 small">
            <span>↪ Replying to @Usernames.Get(_replyTo.AuthorId): @Snippet(_replyTo)</span>
            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" @onclick="CancelReply">✕</button>
        </div>
    }

    @if (_attachments.Count > 0)
    {
        <div class="mb-1">
            @for (var i = 0; i < _attachments.Count; i++)
            {
                var idx = i;
                var a = _attachments[i];
                <span class="badge bg-secondary me-1">
                    @a.Type: @(a.FileName ?? a.Url)
                    <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-white" aria-label="Remove attachment"
                            @onclick="() => RemoveStagedAttachment(idx)">✕</button>
                </span>
            }
        </div>
    }

    <div class="input-group">
        <button type="button" class="btn btn-outline-secondary" @onclick="() => _showAttach = !_showAttach">📎</button>
        <input class="form-control" placeholder="Type a message…" @bind="_draft" @bind:event="oninput"
               @bind:after="OnTypedAsync" @onkeydown="OnKeyDown" />
        <button type="button" class="btn btn-primary" @onclick="SendAsync"
                disabled="@(_sending || (string.IsNullOrWhiteSpace(_draft) && _attachments.Count == 0))">
            @(_sending ? "…" : "Send")
        </button>
    </div>

    @if (_showAttach)
    {
        <div class="card mt-2">
            <div class="card-body py-2">
                <div class="row g-2 align-items-end">
                    <div class="col-auto">
                        <label class="form-label small mb-0">Type</label>
                        <select class="form-select form-select-sm" @bind="_attachDraft.Type">
                            @foreach (var t in Enum.GetValues<AttachmentTypeContract>())
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div class="col">
                        <label class="form-label small mb-0">URL</label>
                        <input class="form-control form-control-sm" @bind="_attachDraft.Url" placeholder="https://…" />
                    </div>
                    <div class="col">
                        <label class="form-label small mb-0">File name (optional)</label>
                        <input class="form-control form-control-sm" @bind="_attachDraft.FileName" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label small mb-0">Size (bytes)</label>
                        <input type="number" class="form-control form-control-sm" @bind="_attachDraft.SizeBytes" style="width:110px;" />
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddStagedAttachment">Attach</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_error is not null)
    {
        <div class="alert alert-danger mt-2">@_error</div>
    }
}

@if (_forwardSource is not null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,.4);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="h5 modal-title">Forward to…</h2>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseForward"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_forwardError))
                    {
                        <div class="alert alert-danger">@_forwardError</div>
                    }
                    @if (_forwardTargets is null)
                    {
                        <p>Loading…</p>
                    }
                    else if (_forwardTargets.Count == 0)
                    {
                        <p class="text-muted">No other chats to forward to.</p>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var target in _forwardTargets)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@(target.Name ?? "(direct)") <span class="badge bg-light text-dark ms-1">@target.Type</span></span>
                                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => ForwardToAsync(target.ChatId)"
                                            disabled="@_forwarding">
                                        Forward
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ChatId { get; set; }

    private Guid _me;
    private ChatDetailsContract? _chat;
    private readonly List<MessageContract> _messages = [];
    private DateTime? _older;
    private string _draft = "";
    private string? _error;
    private string? _loadError;
    private bool _sending;
    private DateTime _lastTypingSent = DateTime.MinValue;
    private readonly HashSet<Guid> _online = [];
    private readonly Dictionary<Guid, DateTime> _typingUntil = [];
    private Timer? _typingSweep;
    private Guid? _reactPickerFor;

    // Actor capabilities
    private bool _isModerator;
    private bool _isPremium;
    private MemberRoleContract? _myRole;

    // Reply
    private MessageContract? _replyTo;

    // Forward modal
    private MessageContract? _forwardSource;
    private IReadOnlyList<ChatSummaryContract>? _forwardTargets;
    private bool _forwarding;
    private string? _forwardError;

    // Attachment composer
    private bool _showAttach;
    private readonly List<SendMessageAttachmentContract> _attachments = new();
    private AttachmentDraft _attachDraft = new();

    // Management panel
    private bool _showManage;
    private string? _renameValue;
    private bool _busyManage;
    private string? _actionError;

    protected override async Task OnInitializedAsync()
    {
        if (Session.UserId is not { } me)
        {
            Nav.NavigateTo("/");
            return;
        }
        _me = me;

        Realtime.MessageSent += OnMessageSent;
        Realtime.MessageRetracted += OnMessageRetracted;
        Realtime.ReactionAdded += OnReactionChanged;
        Realtime.ReactionRemoved += OnReactionChanged;
        Realtime.UserTyping += OnUserTyping;
        Realtime.PresenceChanged += OnPresenceChanged;

        // Core load: the chat itself. A failure here leaves the page in an
        // error state rather than an eternal spinner.
        try
        {
            _chat = await ChatsApi.GetChatByIdAsync(_me, ChatId);
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            return;
        }
        if (_chat is null)
        {
            _loadError = "Chat not found, or you no longer have access to it.";
            return;
        }

        // Core load: the message history.
        try
        {
            var page = await MessagingApi.GetChatMessagesAsync(_me, ChatId, pageSize: 50);
            _messages.AddRange(page.Items.Reverse());
            _older = page.NextCursor;
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            return;
        }

        var memberIds = _chat.Members.Select(m => m.UserId).ToList();

        // Everything below is cosmetic/enrichment — a transient failure of any
        // one of these must not abort the whole render.
        try { await Usernames.EnsureAsync(memberIds.Append(_me)); }
        catch { /* names fall back to short ids */ }

        try
        {
            var presence = await PresenceApi.GetBatchPresenceAsync(_me, memberIds);
            foreach (var (id, isOnline) in presence)
                if (isOnline) _online.Add(id);
        }
        catch { /* online indicator just stays empty */ }

        _myRole = _chat.Members.FirstOrDefault(m => m.UserId == _me && m.Status == MemberStatusContract.Active)?.Role;
        try { _isModerator = await ChatsApi.IsModeratorAsync(_me, ChatId, _me); }
        catch { _isModerator = false; }

        try
        {
            var user = await IdentityUsers.GetUserByIdAsync(_me);
            _isPremium = user?.IsPremium ?? false;
        }
        catch { _isPremium = false; }

        try
        {
            // The SDK records the join intent and (re)connects as needed, so this is
            // safe to call even if the hub isn't up yet — no IsConnected guard required.
            await Realtime.JoinChatAsync(ChatId);
        }
        catch { /* live updates degrade to manual refresh */ }

        try { await NotificationsApi.MarkChatAsReadAsync(_me, ChatId); }
        catch { /* best-effort */ }

        // Typing indicators expire client-side (5s TTL, matching the server's Redis TTL).
        _typingSweep = new Timer(_ => _ = InvokeAsync(() =>
        {
            var now = DateTime.UtcNow;
            var expired = _typingUntil.Where(kv => kv.Value < now).Select(kv => kv.Key).ToList();
            if (expired.Count == 0) return;
            foreach (var id in expired) _typingUntil.Remove(id);
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private ChatMemberContract? OtherDirectMember() => _chat?.Members.FirstOrDefault(m => m.UserId != _me);

    private string ChatTitle()
    {
        if (_chat is null) return "Chat";
        if (_chat.Type == ChatTypeContract.Direct)
        {
            var peer = OtherDirectMember();
            return peer is not null ? Usernames.Get(peer.UserId) : "Direct chat";
        }
        return _chat.Name ?? "Chat";
    }

    private string TypingNames()
        => string.Join(", ", _typingUntil.Keys.Where(id => id != _me).Select(Usernames.Get));

    private static string Glyph(EmojiContract e) => e switch
    {
        EmojiContract.Like => "👍",
        EmojiContract.Heart => "❤️",
        EmojiContract.Laugh => "😂",
        EmojiContract.Wow => "😮",
        EmojiContract.Sad => "😢",
        EmojiContract.Angry => "😠",
        EmojiContract.Fire => "🔥",
        EmojiContract.Dislike => "👎",
        _ => e.ToString()
    };

    private string Snippet(MessageContract m)
    {
        if (m.IsRetracted) return "[retracted]";
        if (!string.IsNullOrWhiteSpace(m.Text))
            return m.Text!.Length > 60 ? m.Text[..60] + "…" : m.Text;
        if (m.Attachments.Count > 0) return $"[{m.Attachments[0].Type.ToString().ToLowerInvariant()}]";
        return "[message]";
    }

    // ---- realtime handlers (background threads → InvokeAsync) ----

    private void OnMessageSent(MessageSentPush push)
    {
        if (push.ChatId != ChatId || push.AuthorId == _me) return;
        _ = InvokeAsync(async () =>
        {
            var msg = await MessagingApi.GetMessageByIdAsync(_me, push.MessageId);
            if (msg is null || _messages.Any(m => m.MessageId == msg.MessageId)) return;
            await Usernames.EnsureAsync([msg.AuthorId]);
            _messages.Add(msg);
            _typingUntil.Remove(msg.AuthorId);
            try { await NotificationsApi.MarkChatAsReadAsync(_me, ChatId); } catch { /* best-effort */ }
            StateHasChanged();
        });
    }

    private void OnMessageRetracted(MessageRetractedPush push)
    {
        if (push.ChatId != ChatId) return;
        _ = InvokeAsync(() => ReplaceMessageAsync(push.MessageId));
    }

    private void OnReactionChanged(ReactionPush push)
    {
        if (push.ChatId != ChatId) return;
        _ = InvokeAsync(() => ReplaceMessageAsync(push.MessageId));
    }

    private async Task ReplaceMessageAsync(Guid messageId)
    {
        var fresh = await MessagingApi.GetMessageByIdAsync(_me, messageId);
        var idx = _messages.FindIndex(m => m.MessageId == messageId);
        if (fresh is not null && idx >= 0)
        {
            _messages[idx] = fresh;
            StateHasChanged();
        }
    }

    private void OnUserTyping(UserTypingPush push)
    {
        if (push.ChatId != ChatId || push.UserId == _me) return;
        _ = InvokeAsync(() =>
        {
            _typingUntil[push.UserId] = DateTime.UtcNow.AddSeconds(5);
            StateHasChanged();
        });
    }

    private void OnPresenceChanged(PresencePush push)
    {
        // Presence pushes are broadcast to every user sharing any chat with the
        // subject, not just this chat's members — ignore anyone not in it, or the
        // online count would be inflated by unrelated users.
        if (_chat is null || !_chat.Members.Any(m => m.UserId == push.UserId)) return;
        _ = InvokeAsync(() =>
        {
            if (push.IsOnline) _online.Add(push.UserId); else _online.Remove(push.UserId);
            StateHasChanged();
        });
    }

    // ---- actions ----

    private async Task OnTypedAsync()
    {
        // Throttle like the Web BFF: at most one StartTyping per 2s (server TTL is 5s).
        if (DateTime.UtcNow - _lastTypingSent < TimeSpan.FromSeconds(2)) return;
        _lastTypingSent = DateTime.UtcNow;
        try { await PresenceApi.StartTypingAsync(_me, ChatId); } catch { /* cosmetic */ }
    }

    private Task OnKeyDown(KeyboardEventArgs e)
        => e.Key == "Enter" ? SendAsync() : Task.CompletedTask;

    private async Task SendAsync()
    {
        if ((string.IsNullOrWhiteSpace(_draft) && _attachments.Count == 0) || _chat is null) return;
        _error = null;
        _sending = true;
        try
        {
            // BFF-style enrichment, done client-side by the SDK helpers.
            var recipients = await ChatsApi.GetActiveRecipientsAsync(_me, ChatId, _me);
            var isBroadcast = _chat.Type == ChatTypeContract.Broadcast;
            var messageId = await MessagingApi.SendMessageAsync(
                _me,
                ChatId,
                string.IsNullOrWhiteSpace(_draft) ? null : _draft.Trim(),
                recipients,
                isBroadcast,
                attachments: _attachments.Count > 0 ? _attachments.ToList() : null,
                replyToMessageId: _replyTo?.MessageId);

            _draft = "";
            _attachments.Clear();
            _replyTo = null;
            _showAttach = false;

            var sent = await MessagingApi.GetMessageByIdAsync(_me, messageId);
            if (sent is not null && !_messages.Any(m => m.MessageId == sent.MessageId))
                _messages.Add(sent);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _sending = false;
        }

        // Stop lingering as "typing…" for the recipient(s) now that the message landed,
        // rather than waiting out the server's 5s TTL.
        try { await PresenceApi.StopTypingAsync(_me, ChatId); } catch { /* cosmetic */ }
    }

    private void ToggleReactPicker(Guid messageId)
        => _reactPickerFor = _reactPickerFor == messageId ? null : messageId;

    private async Task ToggleReactionAsync(MessageContract m, EmojiContract emoji)
    {
        try
        {
            var mine = m.Reactions.Any(r => r.UserId == _me && r.Emoji == emoji);
            if (mine)
                await MessagingApi.RemoveReactionAsync(_me, m.MessageId, emoji);
            else
                await MessagingApi.AddReactionAsync(_me, m.MessageId, emoji, _isPremium);
            _reactPickerFor = null;
            await ReplaceMessageAsync(m.MessageId);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    // ---- Reply ----

    private void SetReply(MessageContract m) => _replyTo = m;
    private void CancelReply() => _replyTo = null;

    private MessageContract? ReplyPreviewFor(MessageContract m)
        => m.ReplyToMessageId is null
            ? null
            : _messages.FirstOrDefault(x => x.MessageId == m.ReplyToMessageId);

    // ---- Retract / Hide ----

    private async Task RetractAsync(MessageContract m)
    {
        try
        {
            await MessagingApi.RetractMessageAsync(_me, m.MessageId, _isModerator);
            await ReplaceMessageAsync(m.MessageId);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task HideAsync(MessageContract m)
    {
        try
        {
            await MessagingApi.HideMessageAsync(_me, m.MessageId);
            _messages.RemoveAll(x => x.MessageId == m.MessageId);
            StateHasChanged();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    // ---- Forward ----

    private async Task OpenForwardAsync(MessageContract m)
    {
        _forwardSource = m;
        _forwardError = null;
        _forwardTargets = null;
        StateHasChanged();
        try
        {
            var all = await ChatsApi.GetMyChatsAsync(_me);
            _forwardTargets = all.Where(c => c.ChatId != ChatId).ToList();
        }
        catch (Exception ex) { _forwardError = ex.Message; }
    }

    private void CloseForward()
    {
        _forwardSource = null;
        _forwardTargets = null;
        _forwardError = null;
    }

    private async Task ForwardToAsync(Guid targetChatId)
    {
        if (_forwardSource is null) return;
        _forwardError = null;
        _forwarding = true;
        try
        {
            var recipients = await ChatsApi.GetActiveRecipientsAsync(_me, targetChatId, _me);
            var type = await ChatsApi.GetChatTypeAsync(_me, targetChatId);

            await MessagingApi.SendMessageAsync(
                authorUserId: _me,
                chatId: targetChatId,
                text: _forwardSource.Text,
                recipients: recipients,
                isBroadcast: type == ChatTypeContract.Broadcast,
                attachments: _forwardSource.Attachments
                    .Select(a => new SendMessageAttachmentContract(a.Type, a.Url, a.SizeBytes, a.FileName))
                    .ToList(),
                forwardOriginalMessageId: _forwardSource.MessageId,
                forwardOriginalChatId: ChatId);

            CloseForward();
            Nav.NavigateTo($"/chat/{targetChatId}");
        }
        catch (Exception ex) { _forwardError = ex.Message; }
        finally { _forwarding = false; }
    }

    // ---- Attachments composer ----

    private void AddStagedAttachment()
    {
        if (string.IsNullOrWhiteSpace(_attachDraft.Url)) { _error = "Attachment URL is required."; return; }
        var size = _attachDraft.SizeBytes <= 0 ? 1 : _attachDraft.SizeBytes;
        _attachments.Add(new SendMessageAttachmentContract(
            _attachDraft.Type,
            _attachDraft.Url.Trim(),
            size,
            string.IsNullOrWhiteSpace(_attachDraft.FileName) ? null : _attachDraft.FileName!.Trim()));
        _attachDraft = new AttachmentDraft();
    }

    private void RemoveStagedAttachment(int index)
    {
        if (index >= 0 && index < _attachments.Count) _attachments.RemoveAt(index);
    }

    // ---- Management panel ----

    private void ToggleManage()
    {
        _showManage = !_showManage;
        _actionError = null;
        if (_showManage) _renameValue = _chat?.Name;
    }

    private async Task ReloadChatDetailsAsync()
    {
        try
        {
            _chat = await ChatsApi.GetChatByIdAsync(_me, ChatId);
            if (_chat is not null)
            {
                _myRole = _chat.Members.FirstOrDefault(m => m.UserId == _me && m.Status == MemberStatusContract.Active)?.Role;
                await Usernames.EnsureAsync(_chat.Members.Select(m => m.UserId));
            }
        }
        catch { /* keep last good state */ }
        StateHasChanged();
    }

    private async Task RenameAsync()
    {
        if (string.IsNullOrWhiteSpace(_renameValue)) { _actionError = "Name is required."; return; }
        _actionError = null;
        _busyManage = true;
        try
        {
            await ChatsApi.RenameChatAsync(_me, ChatId, _renameValue.Trim());
            await ReloadChatDetailsAsync();
        }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _busyManage = false; }
    }

    private async Task KickAsync(Guid targetUserId)
    {
        _actionError = null;
        _busyManage = true;
        try
        {
            await ChatsApi.KickMemberAsync(_me, ChatId, targetUserId);
            await ReloadChatDetailsAsync();
        }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _busyManage = false; }
    }

    private async Task ChangeRoleAsync(Guid targetUserId, MemberRoleContract newRole)
    {
        _actionError = null;
        _busyManage = true;
        try
        {
            await ChatsApi.ChangeMemberRoleAsync(_me, ChatId, targetUserId, newRole);
            await ReloadChatDetailsAsync();
        }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _busyManage = false; }
    }

    private async Task TransferAsync(Guid newOwnerUserId)
    {
        _actionError = null;
        _busyManage = true;
        try
        {
            await ChatsApi.TransferOwnershipAsync(_me, ChatId, newOwnerUserId);
            await ReloadChatDetailsAsync();
        }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _busyManage = false; }
    }

    private async Task LeaveAsync()
    {
        _actionError = null;
        _busyManage = true;
        try
        {
            await ChatsApi.LeaveChatAsync(_me, ChatId);
            Nav.NavigateTo("/chats");
        }
        catch (Exception ex) { _actionError = ex.Message; _busyManage = false; }
    }

    private (string Label, MemberRoleContract Target)? RoleToggle(ChatMemberContract member)
    {
        if (_chat is null || member.Role == MemberRoleContract.Owner) return null;

        return _chat.Type switch
        {
            ChatTypeContract.Group => member.Role == MemberRoleContract.Admin
                ? ("Demote to member", MemberRoleContract.Member)
                : ("Promote to admin", MemberRoleContract.Admin),
            ChatTypeContract.Broadcast => member.Role == MemberRoleContract.Admin
                ? ("Demote to viewer", MemberRoleContract.Viewer)
                : ("Promote to admin", MemberRoleContract.Admin),
            _ => null
        };
    }

    private async Task LoadOlderAsync()
    {
        var page = await MessagingApi.GetChatMessagesAsync(_me, ChatId, before: _older, pageSize: 50);
        _messages.InsertRange(0, page.Items.Reverse());
        _older = page.NextCursor;
        await Usernames.EnsureAsync(page.Items.Select(m => m.AuthorId));
    }

    public async ValueTask DisposeAsync()
    {
        Realtime.MessageSent -= OnMessageSent;
        Realtime.MessageRetracted -= OnMessageRetracted;
        Realtime.ReactionAdded -= OnReactionChanged;
        Realtime.ReactionRemoved -= OnReactionChanged;
        Realtime.UserTyping -= OnUserTyping;
        Realtime.PresenceChanged -= OnPresenceChanged;
        _typingSweep?.Dispose();

        try { await PresenceApi.StopTypingAsync(_me, ChatId); } catch { /* best-effort on teardown */ }

        try
        {
            if (Realtime.IsConnected)
                await Realtime.LeaveChatAsync(ChatId);
        }
        catch { /* connection already gone */ }
    }

    private sealed class AttachmentDraft
    {
        public AttachmentTypeContract Type { get; set; } = AttachmentTypeContract.Image;
        public string Url { get; set; } = "";
        public string? FileName { get; set; }
        public long SizeBytes { get; set; } = 1;
    }
}
