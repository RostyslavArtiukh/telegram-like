    private (string Label, MemberRole TargetRole)? GetRoleToggle(ChatMember member)
    {
        if (openedChat is null || member.Role == MemberRole.Owner) return null;

        return openedChat.Type switch
        {
            ChatType.Group => member.Role == MemberRole.Admin
                ? ("Demote to member", MemberRole.Member)
                : ("Promote to admin", MemberRole.Admin),
            ChatType.Broadcast => member.Role == MemberRole.Admin
                ? ("Demote to viewer", MemberRole.Viewer)
                : ("Promote to admin", MemberRole.Admin),
            _ => null
        };
    }

    private async Task LoadOlderMessagesAsync()
    {
        var page = await MessagingApi.GetChatMessagesAsync(currentUserId, ChatId, before: olderMessagesCursor, pageSize: 50);
        messages.InsertRange(0, page.Items.Reverse());
        olderMessagesCursor = page.NextCursor;
        await Usernames.EnsureAsync(page.Items.Select(m => m.AuthorId));
    }

    public async ValueTask DisposeAsync()
    {
        Realtime.MessageSent -= OnMessageSentPush;
        Realtime.MessageRetracted -= OnMessageRetractedPush;
        Realtime.ReactionAdded -= OnReactionChangedPush;
        Realtime.ReactionRemoved -= OnReactionChangedPush;
        Realtime.UserTyping -= OnUserTypingPush;
        Realtime.PresenceChanged -= OnPresenceChangedPush;
        typingSweepTimer?.Dispose();

        try { await PresenceApi.StopTypingAsync(currentUserId, ChatId); } catch { /* best-effort on teardown */ }

        try
        {
            if (Realtime.IsConnected)
                await Realtime.LeaveChatAsync(ChatId);
        }
        catch { /* connection already gone */ }
    }

    private sealed class AttachmentDraft
    {
        public AttachmentType Type { get; set; } = AttachmentType.Image;
        public string Url { get; set; } = "";
        public string? FileName { get; set; }
        public long SizeBytes { get; set; } = 1;
    }
