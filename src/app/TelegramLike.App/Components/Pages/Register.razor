@page "/register"
@inject TelegramLikeSession Session
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-8">
    <MudCard Elevation="4">
        <MudCardContent>
            <MudText Typo="Typo.h4" GutterBottom="true">Create account</MudText>

            <MudTextField @bind-Value="emailAddress" Label="Email" Placeholder="you@example.com"
                          Variant="Variant.Outlined" InputType="InputType.Email" Class="mb-3" Immediate="true" />
            <MudTextField @bind-Value="username" Label="Username" Placeholder="unique handle"
                          Variant="Variant.Outlined" Class="mb-3" Immediate="true" />
            <MudTextField @bind-Value="displayName" Label="Display name" Placeholder="shown to others"
                          Variant="Variant.Outlined" Class="mb-3" Immediate="true" />
            <MudTextField @bind-Value="password" Label="Password" Placeholder="choose a password"
                          Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-3" Immediate="true"
                          OnKeyDown="SubmitOnEnterAsync" />

            @if (errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
            }

            <MudButton OnClick="CreateAccountAsync" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Disabled="isCreatingAccount" StartIcon="@Icons.Material.Filled.PersonAdd">
                @(isCreatingAccount ? "Creating account…" : "Register")
            </MudButton>

            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
                Already have an account? <MudLink Href="/">Sign in</MudLink>
            </MudText>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private string emailAddress = "";
    private string username = "";
    private string displayName = "";
    private string password = "";
    private string? errorMessage;
    private bool isCreatingAccount;

    private Task SubmitOnEnterAsync(KeyboardEventArgs args)
        => args.Key is "Enter" or "NumpadEnter" ? CreateAccountAsync() : Task.CompletedTask;

    private async Task CreateAccountAsync()
    {
        errorMessage = null;
        isCreatingAccount = true;
        try
        {
            await Session.RegisterAsync(emailAddress.Trim(), username.Trim(), displayName.Trim(), password);
            Navigation.NavigateTo("/?registered=true");
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = $"Cannot reach the backend at {AppConfig.GatewayBaseUrl} — is the stack running?";
        }
        finally
        {
            isCreatingAccount = false;
        }
    }
}
