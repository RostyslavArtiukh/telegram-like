<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Published language, published as a package. Consumers span services, the Web BFF and a
       shipped SDK that don't deploy together, so the version is the coexistence story: additive
       change -> minor, anything a deployed consumer could notice -> major. See CLAUDE.md. -->
  <PropertyGroup>
    <PackageId>TelegramLike.Contracts</PackageId>
    <Version>1.1.0</Version>
    <Description>Integration-event and BFF wire contracts shared by every TelegramLike service and client. POCO records only, zero dependencies.</Description>
  </PropertyGroup>

</Project>
