<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>TelegramLike.Shared.Infrastructure</PackageId>
    <Version>1.0.0</Version>
    <Description>Infrastructure building blocks shared by TelegramLike services: the transactional outbox (outgoing-events queue, sender and metrics), declared Mongo indexes, and the Mongo/Redis/RabbitMQ setup helpers.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TelegramLike.Shared.Application" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit" Version="8.3.0" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.3.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.12.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.7" />
    <PackageReference Include="MongoDB.Driver" Version="3.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared outbox is integration-tested from the Chats test project, which already
         owns the replica-set Mongo fixture the queue needs. Compiled into the package, so it
         keeps working for consumers that reference the package rather than the project. -->
    <InternalsVisibleTo Include="TelegramLike.Chats.Tests" />
  </ItemGroup>

</Project>
