@using TelegramLike.Web.Services
@using TelegramLike.Client.Notifications
@using TelegramLike.Web.Services.UnreadCount
@inject INotificationsApi NotificationsApi
@inject IUnreadCountPubSub UnreadCountPubSub
@inject CurrentUserAccessor CurrentUser
@implements IDisposable

<MudNavMenu>
    <AuthorizeView Context="authenticationState">
        <Authorized>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Chat">
                Chats
            </MudNavLink>

            <MudNavLink Href="/notifications" Icon="@Icons.Material.Filled.Notifications">
                <div class="d-flex align-center justify-space-between" style="width:100%">
                    <span>Notifications</span>
                    @if (unreadNotificationCount > 0)
                    {
                        <MudBadge Content="unreadNotificationCount" Color="Color.Error" Overlap="false" />
                    }
                </div>
            </MudNavLink>

            <MudDivider Class="my-2" />

            <div class="px-4 py-2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Signed in as @authenticationState.User.Identity?.Name
                </MudText>
            </div>

            @* Side-effecting sign-out is a POST guarded by the antiforgery token
               (see Program.cs "/auth/signout"). Keeping it a real <form> submit means
               the browser navigates natively — no interactive circuit dependency. *@
            <form method="post" action="/auth/signout" class="px-2">
                <AntiforgeryToken />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Logout" FullWidth="true"
                           Class="justify-start">
                    Sign out
                </MudButton>
            </form>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login">Sign in</MudNavLink>
            <MudNavLink Href="/register" Icon="@Icons.Material.Filled.PersonAdd">Register</MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private Guid currentUserId;
    private long unreadNotificationCount;
    private IDisposable? unreadCountSubscription;

    protected override async Task OnInitializedAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is null) return;

        currentUserId = userId.Value;
        await RefreshUnreadCountAsync();
        unreadCountSubscription = UnreadCountPubSub.Subscribe(currentUserId, OnUnreadCountChangedAsync);
    }

    private async Task OnUnreadCountChangedAsync()
    {
        await RefreshUnreadCountAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshUnreadCountAsync()
    {
        try
        {
            var latestCount = await NotificationsApi.GetUnreadCountAsync(currentUserId);
            if (latestCount != unreadNotificationCount)
            {
                unreadNotificationCount = latestCount;
                StateHasChanged();
            }
        }
        catch
        {
            // Best-effort: silently swallow transient errors.
        }
    }

    public void Dispose() => unreadCountSubscription?.Dispose();
}
