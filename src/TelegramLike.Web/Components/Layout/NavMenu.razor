@using TelegramLike.Web.Services
@using TelegramLike.Web.Services.NotificationsApi
@inject INotificationsApi NotificationsApi
@inject CurrentUserAccessor CurrentUser
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">TelegramLike</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView Context="auth">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                        <span class="bi bi-chat-dots-fill-nav-menu" aria-hidden="true"></span> Chats
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/notifications">
                        <span class="bi bi-bell-fill-nav-menu" aria-hidden="true"></span> Notifications
                        @if (_unread > 0)
                        {
                            <span class="badge bg-danger ms-2">@_unread</span>
                        }
                    </NavLink>
                </div>
                <div class="nav-item px-3 mt-3 text-white-50">
                    <small>Signed in as @auth.User.Identity?.Name</small>
                </div>
                <div class="nav-item px-3">
                    <a class="nav-link" href="/auth/signout">
                        <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Sign out
                    </a>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/login">Sign in</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/register">Register</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private long _unread;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await RefreshUnreadAsync();
        _timer = new Timer(async _ => await InvokeAsync(RefreshUnreadAsync), null,
            TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task RefreshUnreadAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is null) return;

        try
        {
            var count = await NotificationsApi.GetUnreadCountAsync(userId.Value);
            if (count != _unread)
            {
                _unread = count;
                StateHasChanged();
            }
        }
        catch
        {
            // Background refresh: swallow transient errors, retry on next tick.
        }
    }

    public void Dispose() => _timer?.Dispose();
}
