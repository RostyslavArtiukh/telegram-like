@page "/register"
@using TelegramLike.Client.Identity
@inject IIdentityAuthApi IdentityAuth
@inject NavigationManager Navigation

<PageTitle>Register</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudCard Elevation="4">
        <MudCardContent>
            <MudText Typo="Typo.h4" GutterBottom="true">Create account</MudText>

            <MudTextField @bind-Value="emailAddress" Label="Email" Placeholder="you@example.com"
                          Variant="Variant.Outlined" InputType="InputType.Email" Class="mb-3" Immediate="true" />

            <MudTextField @bind-Value="username" Label="Username" Placeholder="unique handle"
                          Variant="Variant.Outlined" Class="mb-3" Immediate="true" />

            <MudTextField @bind-Value="displayName" Label="Display name" Placeholder="shown to others"
                          Variant="Variant.Outlined" Class="mb-3" Immediate="true" />

            <MudTextField @bind-Value="password" Label="Password" Placeholder="choose a password"
                          Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-3" Immediate="true"
                          OnKeyDown="@(args => SubmitOnEnterAsync(args))" />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
            }

            <MudButton OnClick="CreateAccountAsync" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Disabled="isCreatingAccount"
                       StartIcon="@Icons.Material.Filled.PersonAdd">
                @(isCreatingAccount ? "Creating account…" : "Register")
            </MudButton>

            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
                Already have an account? <MudLink Href="/login">Sign in</MudLink>
            </MudText>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private string emailAddress = "";
    private string username = "";
    private string displayName = "";
    private string password = "";
    private string? errorMessage;
    private bool isCreatingAccount;

    private async Task SubmitOnEnterAsync(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or "NumpadEnter") await CreateAccountAsync();
    }

    private async Task CreateAccountAsync()
    {
        errorMessage = null;
        isCreatingAccount = true;

        try
        {
            await IdentityAuth.RegisterAsync(emailAddress, username, displayName, password);
            Navigation.NavigateTo("/login?registered=true");
        }
        catch (InvalidOperationException ex)
        {
            // Identity rejected the request (validation / duplicate email, etc.) — show its message verbatim.
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            // Downstream outage: timeout, open circuit breaker, DNS/connection failure, etc.
            errorMessage = "Registration is temporarily unavailable. Please try again in a moment.";
        }
        finally
        {
            isCreatingAccount = false;
        }
    }
}
