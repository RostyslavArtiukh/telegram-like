@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using TelegramLike.Web.Services
@using TelegramLike.Client.Chats
@using TelegramLike.Client.Identity
@inject ChatsApiClient ChatsApi
@inject IdentityUsersApiClient IdentityUsers
@inject CurrentUserAccessor CurrentUser
@inject NavigationManager Navigation

<PageTitle>Chats</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Chats</MudText>

<MudGrid>
    <MudItem xs="12" md="7">
        @if (chatListError is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                @chatListError
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="ml-2"
                           OnClick="ReloadChatListAsync">Retry</MudButton>
            </MudAlert>
        }
        else if (myChats is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (myChats.Count == 0)
        {
            <MudAlert Severity="Severity.Info">You have no chats yet. Create one on the right.</MudAlert>
        }
        else
        {
            <MudList T="string" Class="pa-0">
                @foreach (var chat in myChats)
                {
                    <MudListItem T="string" Href="@($"/chat/{chat.ChatId}")"
                                 Icon="@ChatTypeIcon(chat.Type)">
                        <div class="d-flex align-center justify-space-between" style="width:100%">
                            <div>
                                <MudText Typo="Typo.body1">@(chat.Name ?? "(direct)")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @chat.ActiveMemberCount member(s) · you are @chat.MyRole
                                </MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="@ChatTypeColor(chat.Type)"
                                     Variant="Variant.Filled">@chat.Type</MudChip>
                        </div>
                    </MudListItem>
                    <MudDivider />
                }
            </MudList>
        }
    </MudItem>

    <MudItem xs="12" md="5">
        <MudCard Elevation="2" Class="mb-4">
            <MudCardContent>
                <MudText Typo="Typo.h6" GutterBottom="true">Create a group chat</MudText>
                <MudTextField @bind-Value="newGroupName" Label="Group name" Variant="Variant.Outlined"
                              Immediate="true" Class="mb-2" />
                @if (!string.IsNullOrEmpty(groupCreationError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@groupCreationError</MudAlert>
                }
                <MudButton OnClick="CreateGroupChatAsync" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="isSubmitting" StartIcon="@Icons.Material.Filled.GroupAdd">
                    @(isSubmitting ? "Creating…" : "Create group")
                </MudButton>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="2" Class="mb-4">
            <MudCardContent>
                <MudText Typo="Typo.h6" GutterBottom="true">Create a broadcast channel</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Only owners/admins can post; everyone else joins as a viewer.
                </MudText>
                <MudTextField @bind-Value="newBroadcastName" Label="Channel name" Variant="Variant.Outlined"
                              Immediate="true" Class="mb-2" />
                @if (!string.IsNullOrEmpty(broadcastCreationError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@broadcastCreationError</MudAlert>
                }
                <MudButton OnClick="CreateBroadcastChannelAsync" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="isSubmitting" StartIcon="@Icons.Material.Filled.Campaign">
                    @(isSubmitting ? "Creating…" : "Create channel")
                </MudButton>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="2" Class="mb-4">
            <MudCardContent>
                <MudText Typo="Typo.h6" GutterBottom="true">Start a direct chat</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Enter the other person's username.
                </MudText>
                <div class="d-flex align-center" style="gap:8px">
                    <MudTextField @bind-Value="directChatUsername" Placeholder="username"
                                  Variant="Variant.Outlined" Immediate="true" Class="flex-grow-1" />
                    <MudButton OnClick="StartDirectChatAsync" Variant="Variant.Outlined" Color="Color.Primary"
                               Disabled="isSubmitting">Start</MudButton>
                </div>
                @if (!string.IsNullOrEmpty(directChatError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@directChatError</MudAlert>
                }
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="2">
            <MudCardContent>
                <MudText Typo="Typo.h6" GutterBottom="true">Join an existing chat</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Paste a chat id (someone shared it with you).
                </MudText>
                <div class="d-flex align-center" style="gap:8px">
                    <MudTextField @bind-Value="joinChatIdText" Placeholder="00000000-…"
                                  Variant="Variant.Outlined" Immediate="true" Class="flex-grow-1" />
                    <MudButton OnClick="JoinChatByIdAsync" Variant="Variant.Outlined" Color="Color.Primary"
                               Disabled="isSubmitting">Join</MudButton>
                </div>
                @if (!string.IsNullOrEmpty(joinChatError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@joinChatError</MudAlert>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private IReadOnlyList<ChatSummary>? myChats;
    private string newGroupName = "";
    private string newBroadcastName = "";
    private string? groupCreationError;
    private string? broadcastCreationError;
    private string? directChatError;
    private string? joinChatError;
    private string? directChatUsername;
    private string? joinChatIdText;
    private string? chatListError;
    private bool isSubmitting;
    private Guid currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var user = await CurrentUser.GetUserIdAsync();
        if (user is null) return;
        currentUserId = user.Value;
        await ReloadChatListAsync();
    }

    private async Task ReloadChatListAsync()
    {
        try
        {
            myChats = await ChatsApi.GetMyChatsAsync(currentUserId);
            chatListError = null;
        }
        catch (Exception)
        {
            // A transient Chats outage must not throw out of a lifecycle method and
            // kill the whole circuit — degrade to a retryable error state instead.
            chatListError = "Chats are temporarily unavailable.";
        }
    }

    private async Task CreateGroupChatAsync()
    {
        groupCreationError = null;
        if (string.IsNullOrWhiteSpace(newGroupName)) { groupCreationError = "Enter a group name."; return; }
        isSubmitting = true;
        try
        {
            var createdChatId = await ChatsApi.CreateGroupChatAsync(currentUserId, newGroupName.Trim());
            newGroupName = "";
            Navigation.NavigateTo($"/chat/{createdChatId}");
        }
        catch (Exception ex) { groupCreationError = ex.Message; }
        finally { isSubmitting = false; }
    }

    private async Task CreateBroadcastChannelAsync()
    {
        broadcastCreationError = null;
        if (string.IsNullOrWhiteSpace(newBroadcastName)) { broadcastCreationError = "Enter a channel name."; return; }
        isSubmitting = true;
        try
        {
            var createdChatId = await ChatsApi.CreateBroadcastChannelAsync(currentUserId, newBroadcastName.Trim());
            newBroadcastName = "";
            Navigation.NavigateTo($"/chat/{createdChatId}");
        }
        catch (Exception ex) { broadcastCreationError = ex.Message; }
        finally { isSubmitting = false; }
    }

    private async Task StartDirectChatAsync()
    {
        directChatError = null;
        if (string.IsNullOrWhiteSpace(directChatUsername)) { directChatError = "Enter a username."; return; }

        isSubmitting = true;
        try
        {
            var otherUserId = await IdentityUsers.GetUserIdByUsernameAsync(directChatUsername.Trim());
            if (otherUserId is null) { directChatError = "User not found."; return; }
            if (otherUserId == currentUserId) { directChatError = "You can't start a direct chat with yourself."; return; }

            var createdChatId = await ChatsApi.CreateDirectChatAsync(currentUserId, otherUserId.Value);
            directChatUsername = null;
            Navigation.NavigateTo($"/chat/{createdChatId}");
        }
        catch (Exception ex) { directChatError = ex.Message; }
        finally { isSubmitting = false; }
    }

    private async Task JoinChatByIdAsync()
    {
        joinChatError = null;
        if (!Guid.TryParse(joinChatIdText, out var chatId)) { joinChatError = "Invalid id"; return; }
        isSubmitting = true;
        try
        {
            await ChatsApi.JoinChatAsync(currentUserId, chatId);
            Navigation.NavigateTo($"/chat/{chatId}");
        }
        catch (Exception ex) { joinChatError = ex.Message; }
        finally { isSubmitting = false; }
    }

    private static Color ChatTypeColor(ChatType chatType) => chatType switch
    {
        ChatType.Direct => Color.Default,
        ChatType.Group => Color.Primary,
        ChatType.Broadcast => Color.Info,
        _ => Color.Default
    };

    private static string ChatTypeIcon(ChatType chatType) => chatType switch
    {
        ChatType.Direct => Icons.Material.Filled.Person,
        ChatType.Group => Icons.Material.Filled.Group,
        ChatType.Broadcast => Icons.Material.Filled.Campaign,
        _ => Icons.Material.Filled.Chat
    };
}
