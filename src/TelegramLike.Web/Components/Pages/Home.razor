@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using TelegramLike.Web.Services
@using TelegramLike.Client.Chats
@using TelegramLike.Client.Identity
@inject IChatsApi ChatsApi
@inject IIdentityUsersApi IdentityUsers
@inject CurrentUserAccessor CurrentUser
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Chats</PageTitle>

<h1>Chats</h1>

<div class="row">
    <div class="col-md-7">
        @if (_chats is null)
        {
            <p>Loading…</p>
        }
        else if (_chats.Count == 0)
        {
            <div class="alert alert-info">You have no chats yet. Create one on the right.</div>
        }
        else
        {
            <ul class="list-group">
                @foreach (var chat in _chats)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <a href="/chat/@chat.ChatId" class="text-decoration-none fw-semibold">
                                @(chat.Name ?? "(direct)")
                            </a>
                            <span class="badge @TypeBadgeClass(chat.Type) ms-2">@chat.Type</span>
                            <small class="text-muted ms-2">
                                @chat.ActiveMemberCount member(s) · you are @chat.MyRole
                            </small>
                        </div>
                        <code class="text-muted small">@chat.ChatId</code>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Create a group chat</h5>
                <EditForm Model="@_group" OnValidSubmit="CreateGroupAsync" FormName="create-group">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <InputText class="form-control" @bind-Value="_group.Name" />
                    </div>
                    @if (!string.IsNullOrEmpty(_groupError))
                    {
                        <div class="alert alert-danger">@_groupError</div>
                    }
                    <button type="submit" class="btn btn-primary" disabled="@_busy">
                        @(_busy ? "Creating…" : "Create group")
                    </button>
                </EditForm>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <h5 class="card-title">Create a broadcast channel</h5>
                <p class="card-text small text-muted">
                    Only owners/admins can post; everyone else joins as a viewer.
                </p>
                <EditForm Model="@_broadcast" OnValidSubmit="CreateBroadcastAsync" FormName="create-broadcast">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <InputText class="form-control" @bind-Value="_broadcast.Name" />
                    </div>
                    @if (!string.IsNullOrEmpty(_broadcastError))
                    {
                        <div class="alert alert-danger">@_broadcastError</div>
                    }
                    <button type="submit" class="btn btn-primary" disabled="@_busy">
                        @(_busy ? "Creating…" : "Create channel")
                    </button>
                </EditForm>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <h6 class="card-title">Start a direct chat</h6>
                <p class="card-text small text-muted">Enter the other person's username:</p>
                <div class="input-group">
                    <input class="form-control" placeholder="username" @bind="_directUsername" />
                    <button class="btn btn-outline-secondary" @onclick="CreateDirectAsync" disabled="@_busy">Start</button>
                </div>
                @if (!string.IsNullOrEmpty(_directError))
                {
                    <div class="alert alert-danger mt-2 mb-0 small">@_directError</div>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <h6 class="card-title">Join an existing chat</h6>
                <p class="card-text small text-muted">
                    Paste a chat id (someone shared it with you):
                </p>
                <div class="input-group">
                    <input class="form-control" placeholder="00000000-…" @bind="_joinId" />
                    <button class="btn btn-outline-secondary" @onclick="JoinAsync" disabled="@_busy">Join</button>
                </div>
                @if (!string.IsNullOrEmpty(_joinError))
                {
                    <div class="alert alert-danger mt-2 mb-0 small">@_joinError</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<ChatSummaryContract>? _chats;
    private CreateChatModel _group = new();
    private CreateChatModel _broadcast = new();
    private string? _groupError;
    private string? _broadcastError;
    private string? _directError;
    private string? _joinError;
    private string? _directUsername;
    private string? _joinId;
    private bool _busy;
    private Guid _userId;

    protected override async Task OnInitializedAsync()
    {
        var user = await CurrentUser.GetUserIdAsync();
        if (user is null) return;
        _userId = user.Value;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _chats = await ChatsApi.GetMyChatsAsync(_userId);
    }

    private async Task CreateGroupAsync()
    {
        _groupError = null;
        _busy = true;
        try
        {
            var id = await ChatsApi.CreateGroupChatAsync(_userId, _group.Name);
            _group = new CreateChatModel();
            Nav.NavigateTo($"/chat/{id}");
        }
        catch (Exception ex) { _groupError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task CreateBroadcastAsync()
    {
        _broadcastError = null;
        _busy = true;
        try
        {
            var id = await ChatsApi.CreateBroadcastChannelAsync(_userId, _broadcast.Name);
            _broadcast = new CreateChatModel();
            Nav.NavigateTo($"/chat/{id}");
        }
        catch (Exception ex) { _broadcastError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task CreateDirectAsync()
    {
        _directError = null;
        if (string.IsNullOrWhiteSpace(_directUsername)) { _directError = "Enter a username."; return; }

        _busy = true;
        try
        {
            var peerId = await IdentityUsers.GetUserIdByUsernameAsync(_directUsername.Trim());
            if (peerId is null) { _directError = "User not found."; return; }
            if (peerId == _userId) { _directError = "You can't start a direct chat with yourself."; return; }

            var id = await ChatsApi.CreateDirectChatAsync(_userId, peerId.Value);
            _directUsername = null;
            Nav.NavigateTo($"/chat/{id}");
        }
        catch (Exception ex) { _directError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task JoinAsync()
    {
        _joinError = null;
        if (!Guid.TryParse(_joinId, out var chatId)) { _joinError = "Invalid id"; return; }
        _busy = true;
        try
        {
            await ChatsApi.JoinChatAsync(_userId, chatId);
            Nav.NavigateTo($"/chat/{chatId}");
        }
        catch (Exception ex) { _joinError = ex.Message; }
        finally { _busy = false; }
    }

    private static string TypeBadgeClass(ChatTypeContract type) => type switch
    {
        ChatTypeContract.Direct => "bg-secondary",
        ChatTypeContract.Group => "bg-primary",
        ChatTypeContract.Broadcast => "bg-info text-dark",
        _ => "bg-secondary"
    };

    private sealed class CreateChatModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(128, MinimumLength = 1)]
        public string Name { get; set; } = "";
    }
}
