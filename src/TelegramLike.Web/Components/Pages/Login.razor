@page "/login"
@using TelegramLike.Client.Identity
@inject IIdentityAuthApi IdentityAuth
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Sign in</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <h2 class="mb-4">Sign in</h2>

        @if (_justRegistered)
        {
            <div class="alert alert-success">Account created! Please sign in.</div>
        }
        @if (!string.IsNullOrEmpty(_urlError))
        {
            <div class="alert alert-danger">Invalid session. Please try again.</div>
        }

        <EditForm Model="Model" OnValidSubmit="HandleSubmit" FormName="login">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText class="form-control" @bind-Value="Model.Email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <InputText type="password" class="form-control" @bind-Value="Model.Password" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger">@_error</div>
            }

            <button type="submit" class="btn btn-primary w-100" disabled="@_loading">
                @(_loading ? "Signing in..." : "Sign in")
            </button>
        </EditForm>

        <p class="mt-3 text-center">
            No account? <a href="/register">Register</a>
        </p>
    </div>
</div>

@* Hidden auto-submitting form: hands the session token to /auth/signin as a POST
   body (see Program.cs) so it never appears in the URL / browser history / Referer. *@
<form @ref="_signinFormRef" method="post" action="/auth/signin" style="display:none" aria-hidden="true">
    <input type="hidden" name="token" value="@_pendingToken" />
</form>

@code {
    [SupplyParameterFromQuery] private string? Registered { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }

    private LoginModel Model { get; set; } = new();
    private string? _error;
    private string? _urlError;
    private bool _loading;
    private bool _justRegistered;
    private string? _pendingToken;
    private bool _signinFormSubmitted;
    private ElementReference _signinFormRef;

    protected override void OnParametersSet()
    {
        _justRegistered = Registered == "true";
        _urlError = Error;
    }

    private async Task HandleSubmit()
    {
        _error = null;
        _loading = true;

        try
        {
            var token = await IdentityAuth.LoginAsync(Model.Email, Model.Password);
            // Hand off to the hidden form (submitted from OnAfterRenderAsync once the
            // token has actually reached the DOM) rather than navigating with the
            // token in the query string.
            _pendingToken = token;
            _signinFormSubmitted = false;
        }
        catch (InvalidOperationException ex)
        {
            // Identity rejected the credentials / request — show its message verbatim.
            _error = ex.Message;
            _loading = false;
        }
        catch (Exception)
        {
            // Downstream outage: timeout, open circuit breaker, DNS/connection failure, etc.
            _error = "Sign-in is temporarily unavailable. Please try again in a moment.";
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingToken is not null && !_signinFormSubmitted)
        {
            _signinFormSubmitted = true;
            await JS.InvokeVoidAsync("telegramLike.submitForm", _signinFormRef);
        }
    }

    private sealed class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
