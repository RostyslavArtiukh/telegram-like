@page "/login"

<PageTitle>Sign in</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudCard Elevation="4">
        <MudCardContent>
            <MudText Typo="Typo.h4" GutterBottom="true">Sign in</MudText>

            @if (showAccountCreatedNotice)
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">
                    Account created! Please sign in.
                </MudAlert>
            }
            @if (errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
            }

            @* A native POST of the credentials straight to /auth/signin, which performs
               login + token exchange + cookie sign-in entirely server-side (see Program.cs).
               The session token is minted and consumed on the server and never touches the
               browser — no query string, no hidden token field. Styled with MudBlazor but
               kept a real <form method="post"> so the browser navigates natively. *@
            <form method="post" action="/auth/signin">
                <AntiforgeryToken />

                <MudTextField T="string" name="email" Label="Email" Placeholder="you@example.com"
                              Variant="Variant.Outlined" InputType="InputType.Email" Class="mb-3"
                              Required="true" />

                <MudTextField T="string" name="password" Label="Password" Placeholder="Your password"
                              Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-3"
                              Required="true" />

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" StartIcon="@Icons.Material.Filled.Login">
                    Sign in
                </MudButton>
            </form>

            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
                No account? <MudLink Href="/register">Register</MudLink>
            </MudText>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "registered")] private string? RegisteredFlag { get; set; }
    [SupplyParameterFromQuery(Name = "error")] private string? ErrorFlag { get; set; }

    private bool showAccountCreatedNotice;
    private string? errorMessage;

    protected override void OnParametersSet()
    {
        showAccountCreatedNotice = RegisteredFlag == "true";
        errorMessage = ErrorFlag switch
        {
            null => null,
            "invalid" => "Invalid email or password.",
            "unavailable" => "Sign-in is temporarily unavailable. Please try again in a moment.",
            _ => "Invalid session. Please try again."
        };
    }
}
