    private (string Label, MemberRole TargetRole)? GetRoleToggle(ChatMember member)
    {
        if (openedChat is null || member.Role == MemberRole.Owner) return null;

        return openedChat.Type switch
        {
            ChatType.Group => member.Role == MemberRole.Admin
                ? ("Demote to member", MemberRole.Member)
                : ("Promote to admin", MemberRole.Admin),
            ChatType.Broadcast => member.Role == MemberRole.Admin
                ? ("Demote to viewer", MemberRole.Viewer)
                : ("Promote to admin", MemberRole.Admin),
            _ => null
        };
    }

    public async ValueTask DisposeAsync()
    {
        isDisposed = true;
        typingSubscription?.Dispose();
        newMessageSubscription?.Dispose();
        chatChangedSubscription?.Dispose();
        foreach (var subscription in presenceSubscriptions) subscription.Dispose();
        if (backgroundRefreshTimer is not null) await backgroundRefreshTimer.DisposeAsync();
        try { await PresenceApi.StopTypingAsync(currentUserId, ChatId); } catch { }
    }

    private string GetMemberDisplayName(Guid userId) =>
        displayNameByUser.TryGetValue(userId, out var name) ? name : userId.ToString()[..8];

    // The other participant in a direct (1:1) chat, from the current user's point of view.
    private ChatMember? GetOtherDirectMember() =>
        openedChat?.Members.FirstOrDefault(m => m.UserId != currentUserId);

    private string GetChatTitle()
    {
        if (openedChat is null) return "Chat";
        if (openedChat.Type == ChatType.Direct)
        {
            var otherMember = GetOtherDirectMember();
            return otherMember is not null ? GetMemberDisplayName(otherMember.UserId) : "Direct chat";
        }
        return openedChat.Name ?? "Chat";
    }

    private bool IsMemberOnline(Guid userId) =>
        onlineStatusByUser.TryGetValue(userId, out var online) && online;

    private static string GetReactionGlyph(ReactionEmoji emoji) =>
        AvailableReactions.First(r => r.Emoji == emoji).Glyph;

    private string BuildShortMessagePreview(ChatMessage message)
    {
        if (message.IsRetracted) return "[retracted]";
        if (!string.IsNullOrWhiteSpace(message.Text))
            return message.Text!.Length > 60 ? message.Text[..60] + "…" : message.Text;
        if (message.Attachments.Count > 0) return $"[{message.Attachments[0].Type.ToString().ToLowerInvariant()}]";
        return "[message]";
    }

    private string BuildTypingLabel(IReadOnlyCollection<Guid> typingUserIds) => typingUserIds.Count switch
    {
        0 => "",
        1 => $"{GetMemberDisplayName(typingUserIds.First())} is typing…",
        2 => $"{GetMemberDisplayName(typingUserIds.ElementAt(0))} and {GetMemberDisplayName(typingUserIds.ElementAt(1))} are typing…",
        _ => $"{typingUserIds.Count} people are typing…"
    };

    private sealed class MessageComposerModel
    {
        public string Text { get; set; } = "";
    }

    private sealed class AttachmentDraft
    {
        public AttachmentType Type { get; set; } = AttachmentType.Image;
        public string Url { get; set; } = "";
        public string? FileName { get; set; }
        public long SizeBytes { get; set; } = 1;
    }
