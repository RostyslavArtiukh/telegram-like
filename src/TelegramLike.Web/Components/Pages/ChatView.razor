@page "/chat/{ChatId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Collections.Concurrent
@using TelegramLike.Web.Services
@using TelegramLike.Client.Identity
@using TelegramLike.Web.Services.ChatChanged
@using TelegramLike.Client.Chats
@using TelegramLike.Client.Messaging
@using TelegramLike.Web.Services.NewMessage
@using TelegramLike.Client.Notifications
@using TelegramLike.Web.Services.Presence
@using TelegramLike.Client.Presence
@using TelegramLike.Web.Services.Typing
@inject IdentityUsersApiClient IdentityUsers
@inject ChatsApiClient ChatsApi
@inject MessagingApiClient MessagingApi
@inject PresenceApiClient PresenceApi
@inject NotificationsApiClient NotificationsApi
@inject TypingPubSub TypingPubSub
@inject NewMessagePubSub NewMessagePubSub
@inject ChatChangedPubSub ChatChangedPubSub
@inject PresencePubSub PresencePubSub
@inject CurrentUserAccessor CurrentUser
@inject NavigationManager Navigation
@inject IDialogService DialogService
@implements IAsyncDisposable

<PageTitle>@GetChatTitle()</PageTitle>

@if (chatLoadError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-2">@chatLoadError</MudAlert>
    <MudButton Href="/" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">Back to chats</MudButton>
}
else if (openedChat is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <div class="d-flex justify-space-between align-start mb-4">
        <div>
            @if (openedChat.Type == ChatType.Direct)
            {
                var otherMember = GetOtherDirectMember();
                <MudText Typo="Typo.h5">
                    @(otherMember is not null ? GetMemberDisplayName(otherMember.UserId) : "Direct chat")
                </MudText>
                @if (otherMember is not null && IsMemberOnline(otherMember.UserId))
                {
                    <MudText Typo="Typo.caption" Color="Color.Success">● online</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">○ offline</MudText>
                }
            }
            else
            {
                <MudText Typo="Typo.h5">@(openedChat.Name ?? "Chat")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @openedChat.Type ·
                    @openedChat.Members.Count(member => member.Status == MemberStatus.Active) active
                    @if (onlineMemberCount > 0)
                    {
                        <span> · @onlineMemberCount online</span>
                    }
                    · you are @currentUserRole
                </MudText>
            }
            @if (usersCurrentlyTyping.Count > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Primary" Class="fst-italic"
                         Style="min-height:1.25rem;display:block">
                    @BuildTypingLabel(usersCurrentlyTyping)
                </MudText>
            }
        </div>
        <div class="d-flex align-center" style="gap:8px">
            <MudButton OnClick="ToggleManagePanel" Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Settings">Manage</MudButton>
            <MudButton Href="/" Variant="Variant.Outlined" Size="Size.Small">All chats</MudButton>
        </div>
    </div>

    @if (showManagePanel)
    {
        <MudCard Elevation="2" Class="mb-4">
            <MudCardContent>
                <MudText Typo="Typo.h6" GutterBottom="true">Manage chat</MudText>
                @if (!string.IsNullOrEmpty(manageActionError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@manageActionError</MudAlert>
                }

                @if (openedChat.Type != ChatType.Direct && currentUserIsModerator)
                {
                    <div class="d-flex align-center mb-3" style="gap:8px;max-width:420px">
                        <MudTextField @bind-Value="renameChatValue" Label="Rename" Placeholder="@openedChat.Name"
                                      Variant="Variant.Outlined" Immediate="true" Class="flex-grow-1" />
                        <MudButton OnClick="RenameChatAsync" Variant="Variant.Filled" Color="Color.Primary"
                                   Disabled="isManageActionRunning">Save</MudButton>
                    </div>
                }

                <MudText Typo="Typo.subtitle2" GutterBottom="true">Members</MudText>
                <MudList T="string" Class="pa-0 mb-3">
                    @foreach (var member in openedChat.Members.OrderBy(m => m.Role))
                    {
                        var roleToggle = GetRoleToggle(member);
                        var canKickMember = currentUserIsModerator
                            && openedChat.Type != ChatType.Direct
                            && member.Status == MemberStatus.Active
                            && member.UserId != currentUserId
                            && member.Role != MemberRole.Owner;
                        var canTransferOwnership = currentUserRole == MemberRole.Owner
                            && openedChat.Type != ChatType.Direct
                            && member.Status == MemberStatus.Active
                            && member.UserId != currentUserId
                            && member.Role != MemberRole.Owner;
                        // Ban is a GroupChat-only rule; a broadcast viewer can only be kicked.
                        var canBanMember = canKickMember && openedChat.Type == ChatType.Group;

                        <MudListItem T="string">
                            <div class="d-flex align-center justify-space-between" style="width:100%">
                                <div class="d-flex align-center" style="gap:6px">
                                    <MudText Typo="Typo.body2"
                                             Style="@(member.Status != MemberStatus.Active ? "opacity:.6" : "")">
                                        @GetMemberDisplayName(member.UserId)
                                        @if (member.UserId == currentUserId) { <span>(you)</span> }
                                    </MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@member.Role</MudChip>
                                    @if (member.Status != MemberStatus.Active)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">@member.Status</MudChip>
                                    }
                                </div>
                                <div class="d-flex align-center" style="gap:6px">
                                    @if (roleToggle is not null && currentUserIsModerator
                                        && member.Status == MemberStatus.Active && member.UserId != currentUserId)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                   OnClick="() => ChangeMemberRoleAsync(member.UserId, roleToggle.Value.TargetRole)"
                                                   Disabled="isManageActionRunning">
                                            @roleToggle.Value.Label
                                        </MudButton>
                                    }
                                    @if (canTransferOwnership)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                                   OnClick="() => TransferOwnershipAsync(member.UserId)"
                                                   Disabled="isManageActionRunning">Make owner</MudButton>
                                    }
                                    @if (canKickMember)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                                   OnClick="() => KickMemberAsync(member.UserId)"
                                                   Disabled="isManageActionRunning">Kick</MudButton>
                                    }
                                    @if (canBanMember)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                                   OnClick="() => BanMemberAsync(member.UserId)"
                                                   Disabled="isManageActionRunning">Ban</MudButton>
                                    }
                                </div>
                            </div>
                        </MudListItem>
                    }
                </MudList>

                @if (openedChat.Type != ChatType.Direct)
                {
                    <div class="d-flex align-center" style="gap:8px">
                        <MudButton OnClick="LeaveChatAsync" Variant="Variant.Outlined" Color="Color.Error"
                                   Size="Size.Small" Disabled="isManageActionRunning"
                                   StartIcon="@Icons.Material.Filled.ExitToApp">Leave chat</MudButton>
                        @if (currentUserRole == MemberRole.Owner)
                        {
                            <MudButton OnClick="DeleteChatAsync" Variant="Variant.Filled" Color="Color.Error"
                                       Size="Size.Small" Disabled="isManageActionRunning"
                                       StartIcon="@Icons.Material.Filled.DeleteForever">Delete chat</MudButton>
                        }
                    </div>
                }
            </MudCardContent>
        </MudCard>
    }

    <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3"
              Style="height:52vh;overflow-y:auto"
              aria-live="polite" aria-relevant="additions" aria-label="Messages">
        @if (messages.Count == 0)
        {
            <MudText Align="Align.Center" Color="Color.Secondary">No messages yet — say hi.</MudText>
        }
        else
        {
            @foreach (var message in messages.OrderBy(m => m.SentAt))
            {
                var sentByCurrentUser = message.AuthorId == currentUserId;
                var repliedToMessage = FindRepliedToMessage(message);
                <div class="d-flex mb-2 @(sentByCurrentUser ? "justify-end" : "")">
                    <MudPaper Elevation="1" Class="pa-2 px-3"
                              Style="@($"max-width:70%;{(sentByCurrentUser ? "background:var(--mud-palette-primary);color:var(--mud-palette-primary-text)" : "")}")">
                        <MudText Typo="Typo.caption"
                                 Style="@(sentByCurrentUser ? "opacity:.8" : "opacity:.6")">
                            @(sentByCurrentUser ? "you" : GetMemberDisplayName(message.AuthorId))
                            · @message.SentAt.ToLocalTime().ToString("HH:mm")
                            @if (message.ForwardOriginalMessageId is not null)
                            {
                                <span class="fst-italic"> · forwarded</span>
                            }
                        </MudText>

                        @if (repliedToMessage is not null)
                        {
                            <MudText Typo="Typo.caption" Class="pl-2 my-1"
                                     Style="border-left:2px solid currentColor;opacity:.85;display:block">
                                ↪ @(sentByCurrentUser ? "" : GetMemberDisplayName(repliedToMessage.AuthorId) + ": ")@BuildShortMessagePreview(repliedToMessage)
                            </MudText>
                        }

                        <div>
                            @if (message.IsRetracted)
                            {
                                <MudText Class="fst-italic" Style="opacity:.7">[retracted]</MudText>
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(message.Text))
                                {
                                    <MudText Typo="Typo.body2" Style="white-space:pre-wrap">@message.Text</MudText>
                                }
                                @foreach (var attachment in message.Attachments)
                                {
                                    @if (attachment.Type == AttachmentType.Image)
                                    {
                                        <MudImage Src="@attachment.Url" Alt="@(attachment.FileName ?? "image")"
                                                  Fluid="true" Class="rounded mt-1" Style="max-height:220px" />
                                    }
                                    else
                                    {
                                        <MudLink Href="@attachment.Url" Target="_blank" Class="d-block mt-1">
                                            📎 @(attachment.FileName ?? attachment.Url)
                                        </MudLink>
                                    }
                                }
                            }
                        </div>

                        @if (!message.IsRetracted && message.Reactions.Count > 0)
                        {
                            <div class="d-flex flex-wrap mt-1" style="gap:4px">
                                @foreach (var reactionGroup in message.Reactions.GroupBy(r => r.Emoji))
                                {
                                    var reactedByCurrentUser = reactionGroup.Any(r => r.UserId == currentUserId);
                                    <MudButton Size="Size.Small" Class="pa-1"
                                               Variant="@(reactedByCurrentUser ? Variant.Filled : Variant.Outlined)"
                                               aria-label="@($"{reactionGroup.Key} reaction, {reactionGroup.Count()}{(reactedByCurrentUser ? ", added by you — click to remove" : " — click to add")}")"
                                               OnClick="() => ToggleReactionAsync(message, reactionGroup.Key)">
                                        @GetReactionGlyph(reactionGroup.Key) @reactionGroup.Count()
                                    </MudButton>
                                }
                            </div>
                        }

                        @if (openedChat.Type == ChatType.Broadcast && sentByCurrentUser && message.BroadcastReadCount is > 0)
                        {
                            <MudText Typo="Typo.caption" Style="opacity:.8" Class="mt-1">
                                👁 @message.BroadcastReadCount read
                            </MudText>
                        }

                        @if (!message.IsRetracted)
                        {
                            <div class="d-flex align-center mt-1">
                                <MudTooltip Text="React">
                                    <MudIconButton Icon="@Icons.Material.Filled.AddReaction" Size="Size.Small"
                                                   OnClick="() => ToggleReactionPicker(message.MessageId)" aria-label="React" />
                                </MudTooltip>
                                <MudTooltip Text="Reply">
                                    <MudIconButton Icon="@Icons.Material.Filled.Reply" Size="Size.Small"
                                                   OnClick="() => StartReplyingTo(message)" aria-label="Reply" />
                                </MudTooltip>
                                <MudTooltip Text="Forward">
                                    <MudIconButton Icon="@Icons.Material.Filled.Forward" Size="Size.Small"
                                                   OnClick="() => OpenForwardDialogAsync(message)" aria-label="Forward" />
                                </MudTooltip>
                                <MudTooltip Text="Hide for me">
                                    <MudIconButton Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Small"
                                                   OnClick="() => HideMessageAsync(message)" aria-label="Hide" />
                                </MudTooltip>
                                @if (sentByCurrentUser || currentUserIsModerator)
                                {
                                    <MudTooltip Text="Retract for everyone">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                       OnClick="() => RetractMessageAsync(message)" aria-label="Retract" />
                                    </MudTooltip>
                                }
                            </div>
                            @if (reactionPickerMessageId == message.MessageId)
                            {
                                <div class="d-flex flex-wrap mt-1" style="gap:4px">
                                    @foreach (var (emoji, glyph) in AvailableReactions)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="pa-1"
                                                   aria-label="@emoji.ToString()"
                                                   OnClick="() => ToggleReactionAsync(message, emoji)">@glyph</MudButton>
                                    }
                                </div>
                            }
                        }
                    </MudPaper>
                </div>
            }
        }
    </MudPaper>

    @if (messageBeingRepliedTo is not null)
    {
        <MudPaper Outlined="true" Class="d-flex align-center justify-space-between px-3 py-1 mb-1" Elevation="0">
            <MudText Typo="Typo.caption">
                ↪ Replying to @GetMemberDisplayName(messageBeingRepliedTo.AuthorId): @BuildShortMessagePreview(messageBeingRepliedTo)
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CancelReply"
                           aria-label="Cancel reply" />
        </MudPaper>
    }

    @if (stagedAttachments.Count > 0)
    {
        <div class="d-flex flex-wrap mb-1" style="gap:6px">
            @for (var index = 0; index < stagedAttachments.Count; index++)
            {
                var attachmentIndex = index;
                var attachment = stagedAttachments[index];
                <MudChip T="string" Size="Size.Small" Color="Color.Default"
                         OnClose="() => RemoveStagedAttachment(attachmentIndex)">
                    @attachment.Type: @(attachment.FileName ?? attachment.Url)
                </MudChip>
            }
        </div>
    }

    <div class="d-flex align-center" style="gap:8px">
        <MudTooltip Text="Add attachment">
            <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                           OnClick="() => showAttachmentComposer = !showAttachmentComposer"
                           aria-label="Add attachment" />
        </MudTooltip>
        <MudTextField @bind-Value="messageComposer.Text" @bind-Value:after="OnComposerChangedAsync"
                      Placeholder="Type a message…" Variant="Variant.Outlined" Immediate="true"
                      Class="flex-grow-1" OnKeyDown="SendOnEnterAsync" />
        <MudButton OnClick="SendMessageAsync" Variant="Variant.Filled" Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.Send"
                   Disabled="@(isSendingMessage || (string.IsNullOrWhiteSpace(messageComposer.Text) && stagedAttachments.Count == 0))">
            @(isSendingMessage ? "…" : "Send")
        </MudButton>
    </div>
    @if (!string.IsNullOrEmpty(sendError))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@sendError</MudAlert>
    }

    @if (showAttachmentComposer)
    {
        <MudCard Elevation="1" Class="mt-2">
            <MudCardContent>
                <div class="d-flex flex-wrap align-end" style="gap:12px">
                    <MudSelect T="AttachmentType" @bind-Value="attachmentDraft.Type" Label="Type"
                               Variant="Variant.Outlined" Dense="true" Style="min-width:120px">
                        @foreach (var attachmentType in Enum.GetValues<AttachmentType>())
                        {
                            <MudSelectItem Value="attachmentType">@attachmentType</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="attachmentDraft.Url" Label="URL" Placeholder="https://…"
                                  Variant="Variant.Outlined" Class="flex-grow-1" />
                    <MudTextField @bind-Value="attachmentDraft.FileName" Label="File name (optional)"
                                  Variant="Variant.Outlined" Class="flex-grow-1" />
                    <MudTextField @bind-Value="attachmentDraft.SizeBytes" Label="Size (bytes)"
                                  Variant="Variant.Outlined" Style="width:120px" />
                    <MudButton OnClick="AddStagedAttachment" Variant="Variant.Outlined" Color="Color.Primary">
                        Attach
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
}

<MudDialog Visible="messageBeingForwarded is not null" VisibleChanged="OnForwardDialogVisibleChanged"
           Options="new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>Forward to…</TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(forwardError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@forwardError</MudAlert>
        }
        @if (forwardTargetChats is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (forwardTargetChats.Count == 0)
        {
            <MudText Color="Color.Secondary">No other chats to forward to.</MudText>
        }
        else
        {
            <MudList T="string" Class="pa-0">
                @foreach (var targetChat in forwardTargetChats)
                {
                    <MudListItem T="string">
                        <div class="d-flex align-center justify-space-between" style="width:100%">
                            <div class="d-flex align-center" style="gap:6px">
                                <MudText Typo="Typo.body2">@(targetChat.Name ?? "(direct)")</MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@targetChat.Type</MudChip>
                            </div>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="() => ForwardMessageToChatAsync(targetChat.ChatId)"
                                       Disabled="isForwarding">Forward</MudButton>
                        </div>
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public Guid ChatId { get; set; }

    private Guid currentUserId;
    private ChatDetails? openedChat;
    private List<ChatMessage> messages = [];
    private MessageComposerModel messageComposer = new();
    private string? chatLoadError;
    private string? sendError;
    private string? manageActionError;
    private bool isSendingMessage;
    private Timer? backgroundRefreshTimer;
    private volatile bool isDisposed;
    private IDisposable? typingSubscription;
    private IDisposable? newMessageSubscription;
    private IDisposable? chatChangedSubscription;
    private readonly List<IDisposable> presenceSubscriptions = new();
    // Written from the pubsub consumer thread (OnMemberStartedTypingAsync) and read/mutated
    // from the dispatcher-driven timer (RemoveExpiredTypingIndicators) — a plain Dictionary
    // would race there, so this uses a concurrent collection instead.
    private readonly ConcurrentDictionary<Guid, DateTime> typingExpiryByUser = new();
    private List<Guid> usersCurrentlyTyping = [];
    private int onlineMemberCount;
    private Dictionary<Guid, bool> onlineStatusByUser = new();
    private Dictionary<Guid, string> displayNameByUser = new();
    private DateTime lastTypingSignalSentAt = DateTime.MinValue;
    private static readonly TimeSpan TypingSignalThrottle = TimeSpan.FromSeconds(2);
    private static readonly TimeSpan TypingIndicatorLifetime = TimeSpan.FromSeconds(5);

    // What the current user is allowed to do in this chat.
    private bool currentUserIsModerator;
    private MemberRole? currentUserRole;

    // Per-message UI state.
    private ChatMessage? messageBeingRepliedTo;
    private Guid? reactionPickerMessageId;

    // Forward dialog.
    private ChatMessage? messageBeingForwarded;
    private IReadOnlyList<ChatSummary>? forwardTargetChats;
    private bool isForwarding;
    private string? forwardError;

    // Attachment composer.
    private bool showAttachmentComposer;
    private readonly List<OutgoingAttachment> stagedAttachments = new();
    private AttachmentDraft attachmentDraft = new();

    // Management panel.
    private bool showManagePanel;
    private string? renameChatValue;
    private bool isManageActionRunning;

    private static readonly (ReactionEmoji Emoji, string Glyph)[] AvailableReactions =
    {
        (ReactionEmoji.Like, "👍"),
        (ReactionEmoji.Heart, "❤️"),
        (ReactionEmoji.Laugh, "😂"),
        (ReactionEmoji.Wow, "😮"),
        (ReactionEmoji.Sad, "😢"),
        (ReactionEmoji.Angry, "😠"),
        (ReactionEmoji.Fire, "🔥"),
        (ReactionEmoji.Dislike, "👎"),
    };

    protected override async Task OnInitializedAsync()
    {
        var user = await CurrentUser.GetUserIdAsync();
        if (user is null) { Navigation.NavigateTo("/login", forceLoad: true); return; }
        currentUserId = user.Value;

        await LoadChatDetailsAsync();
        await LoadMemberDisplayNamesAsync();
        await LoadCurrentUserCapabilitiesAsync();
        await ReloadMessagesAsync();
        await RefreshMemberPresenceAsync();
        await MarkChatNotificationsReadAsync();

        typingSubscription = TypingPubSub.Subscribe(ChatId, OnMemberStartedTypingAsync);
        newMessageSubscription = NewMessagePubSub.Subscribe(ChatId, OnNewMessageArrivedAsync);
        chatChangedSubscription = ChatChangedPubSub.Subscribe(ChatId, OnChatChangedAsync);

        SubscribeToMemberPresence();

        backgroundRefreshTimer = new Timer(async _ =>
        {
            // Guard against firing into a torn-down circuit (tab closed mid-interval),
            // which would otherwise throw ObjectDisposedException on a threadpool thread.
            if (isDisposed) return;
            try { await InvokeAsync(RunBackgroundRefreshAsync); }
            catch (ObjectDisposedException) { /* circuit gone before the timer fired */ }
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private int backgroundRefreshTickCount;

    private async Task RunBackgroundRefreshAsync()
    {
        RemoveExpiredTypingIndicators();
        if (++backgroundRefreshTickCount % 10 == 0) await RefreshMemberPresenceAsync();
    }

    private async Task LoadCurrentUserCapabilitiesAsync()
    {
        if (openedChat is null) return;

        currentUserRole = openedChat.Members
            .FirstOrDefault(m => m.UserId == currentUserId && m.Status == MemberStatus.Active)?.Role;

        try { currentUserIsModerator = await ChatsApi.IsModeratorAsync(currentUserId, ChatId, currentUserId); }
        catch { currentUserIsModerator = false; }
    }

    private void SubscribeToMemberPresence()
    {
        if (openedChat is null) return;

        foreach (var member in openedChat.Members
            .Where(m => m.Status == MemberStatus.Active)
            .Where(m => m.UserId != currentUserId))
        {
            presenceSubscriptions.Add(PresencePubSub.Subscribe(member.UserId, OnMemberPresenceChangedAsync));
        }
    }

    private async Task OnMemberPresenceChangedAsync(bool _)
    {
        await RefreshMemberPresenceAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnNewMessageArrivedAsync(Guid _)
    {
        await ReloadMessagesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnChatChangedAsync()
    {
        await ReloadMessagesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadChatDetailsAsync()
    {
        try
        {
            openedChat = await ChatsApi.GetChatByIdAsync(currentUserId, ChatId);
            if (openedChat is null) chatLoadError = "Chat not found.";
        }
        catch (Exception ex) { chatLoadError = ex.Message; }
    }

    private async Task LoadMemberDisplayNamesAsync()
    {
        if (openedChat is null) return;
        try
        {
            var memberIds = openedChat.Members.Select(m => m.UserId).ToList();
            var displayNames = await IdentityUsers.GetUsernamesByIdsAsync(memberIds);
            displayNameByUser = displayNames.ToDictionary(kv => kv.Key, kv => kv.Value);
        }
        catch { /* fall back to GUID display */ }
    }

    private async Task ReloadMessagesAsync()
    {
        try
        {
            var page = await MessagingApi.GetChatMessagesAsync(currentUserId, ChatId);

            // Compare message ids rather than counts: a concurrent hide/retract can
            // shrink or hold steady the count in the same refresh a real new message
            // arrives, which would mask it under a simple Count comparison.
            var existingMessageIds = messages.Select(m => m.MessageId).ToHashSet();
            var newMessageArrived = page.Items.Any(m => !existingMessageIds.Contains(m.MessageId));

            messages = page.Items.ToList();

            // No StateHasChanged here: this method also runs off the dispatcher (from
            // the MassTransit consumer thread via OnNewMessageArrivedAsync/OnChatChangedAsync),
            // where calling it directly throws. Callers on the dispatcher (lifecycle /
            // event handlers) get an implicit re-render anyway; off-dispatcher callers
            // already wrap this call in InvokeAsync(StateHasChanged).
            if (newMessageArrived) await MarkChatNotificationsReadAsync();
        }
        catch { /* keep last good state */ }
    }

    private async Task MarkChatNotificationsReadAsync()
    {
        try { await NotificationsApi.MarkChatAsReadAsync(currentUserId, ChatId); }
        catch { /* best-effort */ }
    }

    private async Task RefreshMemberPresenceAsync()
    {
        if (openedChat is null) return;
        try
        {
            var otherActiveMemberIds = openedChat.Members
                .Where(m => m.Status == MemberStatus.Active)
                .Select(m => m.UserId)
                .Where(id => id != currentUserId)
                .ToList();

            if (otherActiveMemberIds.Count == 0) return;

            var presenceByUser = await PresenceApi.GetBatchPresenceAsync(currentUserId, otherActiveMemberIds);
            onlineStatusByUser = presenceByUser.ToDictionary(kv => kv.Key, kv => kv.Value);
            var onlineNow = onlineStatusByUser.Count(kv => kv.Value);
            if (onlineNow != onlineMemberCount)
            {
                onlineMemberCount = onlineNow;
            }
            StateHasChanged();
        }
        catch { /* best-effort */ }
    }

    private async Task OnMemberStartedTypingAsync(Guid typingUserId)
    {
        if (typingUserId == currentUserId) return;

        typingExpiryByUser[typingUserId] = DateTime.UtcNow + TypingIndicatorLifetime;
        RebuildTypingMemberList();
        await InvokeAsync(StateHasChanged);
    }

    private void RemoveExpiredTypingIndicators()
    {
        var now = DateTime.UtcNow;
        var expiredUserIds = typingExpiryByUser.Where(kv => kv.Value <= now).Select(kv => kv.Key).ToList();
        if (expiredUserIds.Count == 0) return;

        foreach (var userId in expiredUserIds) typingExpiryByUser.TryRemove(userId, out _);
        RebuildTypingMemberList();
        StateHasChanged();
    }

    private void RebuildTypingMemberList()
    {
        var rebuiltList = typingExpiryByUser.Keys.OrderBy(id => id).ToList();
        if (!usersCurrentlyTyping.SequenceEqual(rebuiltList))
            usersCurrentlyTyping = rebuiltList;
    }

    private async Task OnComposerChangedAsync()
    {
        if (string.IsNullOrWhiteSpace(messageComposer.Text)) return;

        var now = DateTime.UtcNow;
        if (now - lastTypingSignalSentAt < TypingSignalThrottle) return;
        lastTypingSignalSentAt = now;

        try { await PresenceApi.StartTypingAsync(currentUserId, ChatId); }
        catch { /* best-effort */ }
    }

    private async Task SendOnEnterAsync(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or "NumpadEnter" && !args.ShiftKey) await SendMessageAsync();
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(messageComposer.Text) && stagedAttachments.Count == 0) return;
        if (openedChat is null) return;

        sendError = null;
        isSendingMessage = true;
        try
        {
            // Recipients are Messaging's own business ([TL-118]) — it derives them from its
            // membership read-model. Broadcast-ness is still passed as a fallback for a chat
            // its chat-type read-model hasn't materialized yet.
            var isBroadcastChat = openedChat.Type == ChatType.Broadcast;

            await MessagingApi.SendMessageAsync(
                authorUserId: currentUserId,
                chatId: ChatId,
                text: string.IsNullOrWhiteSpace(messageComposer.Text) ? null : messageComposer.Text,
                isBroadcast: isBroadcastChat,
                attachments: stagedAttachments.Count > 0 ? stagedAttachments.ToList() : null,
                replyToMessageId: messageBeingRepliedTo?.MessageId);

            messageComposer = new MessageComposerModel();
            stagedAttachments.Clear();
            messageBeingRepliedTo = null;
            showAttachmentComposer = false;
            await ReloadMessagesAsync();
            try { await PresenceApi.StopTypingAsync(currentUserId, ChatId); } catch { }
        }
        catch (Exception ex) { sendError = ex.Message; }
        finally { isSendingMessage = false; }
    }

    // ---- Reactions ----

    private void ToggleReactionPicker(Guid messageId)
        => reactionPickerMessageId = reactionPickerMessageId == messageId ? null : messageId;

    private async Task ToggleReactionAsync(ChatMessage message, ReactionEmoji emoji)
    {
        sendError = null;
        var alreadyReactedWithEmoji = message.Reactions.Any(r => r.UserId == currentUserId && r.Emoji == emoji);
        try
        {
            if (alreadyReactedWithEmoji)
                await MessagingApi.RemoveReactionAsync(currentUserId, message.MessageId, emoji);
            else
                await MessagingApi.AddReactionAsync(currentUserId, message.MessageId, emoji);

            reactionPickerMessageId = null;
            await ReloadMessagesAsync();
        }
        catch (Exception ex) { sendError = ex.Message; }
    }

