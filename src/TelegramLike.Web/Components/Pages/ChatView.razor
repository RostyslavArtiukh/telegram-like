    // ---- Forward ----

    private async Task OpenForwardDialogAsync(ChatMessage message)
    {
        messageBeingForwarded = message;
        forwardError = null;
        forwardTargetChats = null;
        StateHasChanged();
        try
        {
            var allChats = await ChatsApi.GetMyChatsAsync(currentUserId);
            forwardTargetChats = allChats.Where(c => c.ChatId != ChatId).ToList();
        }
        catch (Exception ex) { forwardError = ex.Message; }
    }

    private void OnForwardDialogVisibleChanged(bool visible)
    {
        if (!visible) CloseForwardDialog();
    }

    private void CloseForwardDialog()
    {
        messageBeingForwarded = null;
        forwardTargetChats = null;
        forwardError = null;
    }

    private async Task ForwardMessageToChatAsync(Guid targetChatId)
    {
        if (messageBeingForwarded is null) return;
        forwardError = null;
        isForwarding = true;
        try
        {
            var targetChatType = await ChatsApi.GetChatTypeAsync(currentUserId, targetChatId);

            await MessagingApi.SendMessageAsync(
                authorUserId: currentUserId,
                chatId: targetChatId,
                text: messageBeingForwarded.Text,
                isBroadcast: targetChatType == ChatType.Broadcast,
                attachments: messageBeingForwarded.Attachments
                    .Select(a => new OutgoingAttachment(a.Type, a.Url, a.SizeBytes, a.FileName))
                    .ToList(),
                forwardOriginalMessageId: messageBeingForwarded.MessageId,
                forwardOriginalChatId: ChatId);

            CloseForwardDialog();
            Navigation.NavigateTo($"/chat/{targetChatId}");
        }
        catch (Exception ex) { forwardError = ex.Message; }
        finally { isForwarding = false; }
    }

    // ---- Attachments composer ----

    private void AddStagedAttachment()
    {
        if (string.IsNullOrWhiteSpace(attachmentDraft.Url)) { sendError = "Attachment URL is required."; return; }
        var sizeBytes = attachmentDraft.SizeBytes <= 0 ? 1 : attachmentDraft.SizeBytes;
        stagedAttachments.Add(new OutgoingAttachment(
            attachmentDraft.Type,
            attachmentDraft.Url.Trim(),
            sizeBytes,
            string.IsNullOrWhiteSpace(attachmentDraft.FileName) ? null : attachmentDraft.FileName!.Trim()));
        attachmentDraft = new AttachmentDraft();
    }

    private void RemoveStagedAttachment(int index)
    {
        if (index >= 0 && index < stagedAttachments.Count) stagedAttachments.RemoveAt(index);
    }

