@page "/chat/{ChatId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using MediatR
@using TelegramLike.Application.Identity.Queries.GetUsernamesByIds
@using TelegramLike.Web.Services
@using TelegramLike.Web.Services.ChatChanged
@using TelegramLike.Web.Services.ChatsApi
@using TelegramLike.Web.Services.MessagingApi
@using TelegramLike.Web.Services.NewMessage
@using TelegramLike.Web.Services.NotificationsApi
@using TelegramLike.Web.Services.Presence
@using TelegramLike.Web.Services.PresenceApi
@using TelegramLike.Web.Services.Typing
@inject IMediator Mediator
@inject IChatsApi ChatsApi
@inject IMessagingApi MessagingApi
@inject IPresenceApi PresenceApi
@inject INotificationsApi NotificationsApi
@inject ITypingPubSub TypingPubSub
@inject INewMessagePubSub NewMessagePubSub
@inject IChatChangedPubSub ChatChangedPubSub
@inject IPresencePubSub PresencePubSub
@inject CurrentUserAccessor CurrentUser
@inject NavigationManager Nav
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>@(_chat?.Name ?? "Chat")</PageTitle>

@if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
    <a href="/" class="btn btn-link">← Back to chats</a>
}
else if (_chat is null)
{
    <p>Loading…</p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h3 class="mb-1">@(_chat.Name ?? "Direct chat")</h3>
            <small class="text-muted">
                @_chat.Type ·
                @_chat.Members.Count(m => m.Status == MemberStatusContract.Active) active
                @if (_onlineCount > 0)
                {
                    <span class="text-success">· @_onlineCount online</span>
                }
            </small>
            @if (_othersTyping.Count > 0)
            {
                <div class="text-primary fst-italic small mt-1" style="min-height: 1.25rem;">
                    @TypingLabel(_othersTyping)
                </div>
            }
        </div>
        <a href="/" class="btn btn-sm btn-outline-secondary">All chats</a>
    </div>

    <div class="border rounded p-3 mb-3" style="height: 50vh; overflow-y: auto; background: #f9f9f9;">
        @if (_messages.Count == 0)
        {
            <p class="text-muted text-center">No messages yet — say hi.</p>
        }
        else
        {
            @foreach (var m in _messages.OrderBy(x => x.SentAt))
            {
                var isMine = m.AuthorId == _userId;
                <div class="d-flex mb-2 @(isMine ? "justify-content-end" : "")">
                    <div class="@(isMine ? "bg-primary text-white" : "bg-white border") rounded p-2 px-3" style="max-width: 70%;">
                        <div class="small @(isMine ? "text-white-50" : "text-muted")">
                            @(isMine ? "you" : DisplayName(m.AuthorId)) · @m.SentAt.ToLocalTime().ToString("HH:mm")
                        </div>
                        <div>
                            @if (m.IsRetracted)
                            {
                                <em class="text-muted">[retracted]</em>
                            }
                            else
                            {
                                @m.Text
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <EditForm Model="@_send" OnValidSubmit="SendAsync" FormName="send-message">
        <div class="input-group">
            <InputText class="form-control" placeholder="Type a message…"
                       @bind-Value="_send.Text" @oninput="OnInputAsync" />
            <button class="btn btn-primary" type="submit" disabled="@(_sending || string.IsNullOrWhiteSpace(_send.Text))">
                @(_sending ? "…" : "Send")
            </button>
        </div>
        @if (!string.IsNullOrEmpty(_sendError))
        {
            <div class="alert alert-danger mt-2">@_sendError</div>
        }
    </EditForm>
}

@code {
    [Parameter] public Guid ChatId { get; set; }

    private Guid _userId;
    private ChatDetailsContract? _chat;
    private List<MessageContract> _messages = [];
    private SendModel _send = new();
    private string? _loadError;
    private string? _sendError;
    private bool _sending;
    private Timer? _poller;
    private IDisposable? _typingSubscription;
    private IDisposable? _newMessageSubscription;
    private IDisposable? _chatChangedSubscription;
    private readonly List<IDisposable> _presenceSubscriptions = new();
    private readonly Dictionary<Guid, DateTime> _typingExpiry = new();
    private List<Guid> _othersTyping = [];
    private int _onlineCount;
    private Dictionary<Guid, string> _usernames = new();
    private DateTime _lastTypingHitUtc = DateTime.MinValue;
    private static readonly TimeSpan TypingThrottle = TimeSpan.FromSeconds(2);
    private static readonly TimeSpan TypingTtl = TimeSpan.FromSeconds(5);

    protected override async Task OnInitializedAsync()
    {
        var u = await CurrentUser.GetUserIdAsync();
        if (u is null) { Nav.NavigateTo("/login", forceLoad: true); return; }
        _userId = u.Value;

        await LoadChatAsync();
        await LoadUsernamesAsync();
        await ReloadMessagesAsync();
        await RefreshPresenceAsync();
        await MarkChatNotificationsReadAsync();

        _typingSubscription = TypingPubSub.Subscribe(ChatId, OnRemoteTypingAsync);
        _newMessageSubscription = NewMessagePubSub.Subscribe(ChatId, OnNewMessageAsync);
        _chatChangedSubscription = ChatChangedPubSub.Subscribe(ChatId, OnChatChangedAsync);

        SubscribeToPresenceForMembers();

        _poller = new Timer(async _ => await InvokeAsync(PollAsync), null,
            TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private int _pollTick;

    private async Task PollAsync()
    {
        SweepExpiredTyping();
        if (++_pollTick % 10 == 0) await RefreshPresenceAsync();
    }

    private void SubscribeToPresenceForMembers()
    {
        if (_chat is null) return;

        foreach (var member in _chat.Members
            .Where(m => m.Status == MemberStatusContract.Active)
            .Where(m => m.UserId != _userId))
        {
            _presenceSubscriptions.Add(PresencePubSub.Subscribe(member.UserId, OnPresenceChangedAsync));
        }
    }

    private async Task OnPresenceChangedAsync(bool _)
    {
        await RefreshPresenceAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnNewMessageAsync(Guid _)
    {
        await ReloadMessagesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnChatChangedAsync()
    {
        await ReloadMessagesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadChatAsync()
    {
        try
        {
            _chat = await ChatsApi.GetChatByIdAsync(_userId, ChatId);
            if (_chat is null) _loadError = "Chat not found.";
        }
        catch (Exception ex) { _loadError = ex.Message; }
    }

    private async Task LoadUsernamesAsync()
    {
        if (_chat is null) return;
        try
        {
            var ids = _chat.Members.Select(m => m.UserId).ToList();
            var map = await Mediator.Send(new GetUsernamesByIdsQuery(ids));
            _usernames = map.ToDictionary(kv => kv.Key, kv => kv.Value);
        }
        catch { /* fall back to GUID display */ }
    }

    private async Task ReloadMessagesAsync()
    {
        try
        {
            var page = await MessagingApi.GetChatMessagesAsync(_userId, ChatId);
            var grew = page.Items.Count > _messages.Count;
            _messages = page.Items.ToList();
            StateHasChanged();

            if (grew) await MarkChatNotificationsReadAsync();
        }
        catch { /* keep last good state */ }
    }

    private async Task MarkChatNotificationsReadAsync()
    {
        try { await NotificationsApi.MarkChatAsReadAsync(_userId, ChatId); }
        catch { /* best-effort */ }
    }

    private async Task RefreshPresenceAsync()
    {
        if (_chat is null) return;
        try
        {
            var members = _chat.Members
                .Where(m => m.Status == MemberStatusContract.Active)
                .Select(m => m.UserId)
                .Where(id => id != _userId)
                .ToList();

            if (members.Count == 0) return;

            var presence = await PresenceApi.GetBatchPresenceAsync(_userId, members);
            var online = presence.Count(kv => kv.Value);
            if (online != _onlineCount)
            {
                _onlineCount = online;
                StateHasChanged();
            }
        }
        catch { /* best-effort */ }
    }

    private async Task OnRemoteTypingAsync(Guid userId)
    {
        if (userId == _userId) return;

        _typingExpiry[userId] = DateTime.UtcNow + TypingTtl;
        RebuildTypingList();
        await InvokeAsync(StateHasChanged);
    }

    private void SweepExpiredTyping()
    {
        var now = DateTime.UtcNow;
        var expired = _typingExpiry.Where(kv => kv.Value <= now).Select(kv => kv.Key).ToList();
        if (expired.Count == 0) return;

        foreach (var id in expired) _typingExpiry.Remove(id);
        RebuildTypingList();
        StateHasChanged();
    }

    private void RebuildTypingList()
    {
        var newList = _typingExpiry.Keys.OrderBy(x => x).ToList();
        if (!_othersTyping.SequenceEqual(newList))
            _othersTyping = newList;
    }

    private async Task OnInputAsync(ChangeEventArgs e)
    {
        _send.Text = e.Value?.ToString() ?? "";

        if (string.IsNullOrWhiteSpace(_send.Text)) return;

        var now = DateTime.UtcNow;
        if (now - _lastTypingHitUtc < TypingThrottle) return;
        _lastTypingHitUtc = now;

        try { await PresenceApi.StartTypingAsync(_userId, ChatId); }
        catch { /* best-effort */ }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_send.Text)) return;
        if (_chat is null) return;

        _sendError = null;
        _sending = true;
        try
        {
            // BFF enrichment: Messaging has no access to Chats data, so we resolve
            // recipients (all active members except author) and broadcast flag here.
            var recipients = _chat.Members
                .Where(m => m.Status == MemberStatusContract.Active && m.UserId != _userId)
                .Select(m => m.UserId)
                .ToList();

            var isBroadcast = _chat.Type == ChatTypeContract.Broadcast;

            await MessagingApi.SendMessageAsync(
                authorUserId: _userId,
                chatId: ChatId,
                text: _send.Text,
                recipients: recipients,
                isBroadcast: isBroadcast);

            _send = new SendModel();
            await ReloadMessagesAsync();
            try { await PresenceApi.StopTypingAsync(_userId, ChatId); } catch { }
        }
        catch (Exception ex) { _sendError = ex.Message; }
        finally { _sending = false; }
    }

    public async ValueTask DisposeAsync()
    {
        _typingSubscription?.Dispose();
        _newMessageSubscription?.Dispose();
        _chatChangedSubscription?.Dispose();
        foreach (var sub in _presenceSubscriptions) sub.Dispose();
        if (_poller is not null) await _poller.DisposeAsync();
        try { await PresenceApi.StopTypingAsync(_userId, ChatId); } catch { }
    }

    private string DisplayName(Guid userId) =>
        _usernames.TryGetValue(userId, out var name) ? name : userId.ToString()[..8];

    private string TypingLabel(IReadOnlyCollection<Guid> users) => users.Count switch
    {
        0 => "",
        1 => $"{DisplayName(users.First())} is typing…",
        2 => $"{DisplayName(users.ElementAt(0))} and {DisplayName(users.ElementAt(1))} are typing…",
        _ => $"{users.Count} people are typing…"
    };

    private sealed class SendModel
    {
        public string Text { get; set; } = "";
    }
}
