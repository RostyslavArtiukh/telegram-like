@page "/chat/{ChatId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using TelegramLike.Web.Services
@using TelegramLike.Client.Identity
@using TelegramLike.Web.Services.ChatChanged
@using TelegramLike.Client.Chats
@using TelegramLike.Client.Messaging
@using TelegramLike.Web.Services.NewMessage
@using TelegramLike.Client.Notifications
@using TelegramLike.Web.Services.Presence
@using TelegramLike.Client.Presence
@using TelegramLike.Web.Services.Typing
@inject IIdentityUsersApi IdentityUsers
@inject IChatsApi ChatsApi
@inject IMessagingApi MessagingApi
@inject IPresenceApi PresenceApi
@inject INotificationsApi NotificationsApi
@inject ITypingPubSub TypingPubSub
@inject INewMessagePubSub NewMessagePubSub
@inject IChatChangedPubSub ChatChangedPubSub
@inject IPresencePubSub PresencePubSub
@inject CurrentUserAccessor CurrentUser
@inject NavigationManager Nav
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>@ChatTitle()</PageTitle>

@if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
    <a href="/" class="btn btn-link">← Back to chats</a>
}
else if (_chat is null)
{
    <p>Loading…</p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            @if (_chat.Type == ChatTypeContract.Direct)
            {
                var peer = OtherDirectMember();
                <h3 class="mb-1">@(peer is not null ? DisplayName(peer.UserId) : "Direct chat")</h3>
                <small>
                    @if (peer is not null && IsOnline(peer.UserId))
                    {
                        <span class="text-success">● online</span>
                    }
                    else
                    {
                        <span class="text-muted">○ offline</span>
                    }
                </small>
            }
            else
            {
                <h3 class="mb-1">@(_chat.Name ?? "Chat")</h3>
                <small class="text-muted">
                    @_chat.Type ·
                    @_chat.Members.Count(m => m.Status == MemberStatusContract.Active) active
                    @if (_onlineCount > 0)
                    {
                        <span class="text-success">· @_onlineCount online</span>
                    }
                    · you are @_myRole
                </small>
            }
            @if (_othersTyping.Count > 0)
            {
                <div class="text-primary fst-italic small mt-1" style="min-height: 1.25rem;">
                    @TypingLabel(_othersTyping)
                </div>
            }
        </div>
        <div class="btn-group btn-group-sm">
            <button class="btn btn-outline-secondary" @onclick="ToggleManage">Manage</button>
            <a href="/" class="btn btn-outline-secondary">All chats</a>
        </div>
    </div>

    @if (_showManage)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Manage chat</h5>
                @if (!string.IsNullOrEmpty(_actionError))
                {
                    <div class="alert alert-danger">@_actionError</div>
                }

                @if (_chat.Type != ChatTypeContract.Direct && _isModerator)
                {
                    <div class="input-group input-group-sm mb-3" style="max-width: 420px;">
                        <span class="input-group-text">Rename</span>
                        <input class="form-control" @bind="_renameValue" placeholder="@_chat.Name" />
                        <button class="btn btn-outline-primary" @onclick="RenameAsync" disabled="@_busyManage">Save</button>
                    </div>
                }

                <h6>Members</h6>
                <ul class="list-group mb-3">
                    @foreach (var member in _chat.Members.OrderBy(m => m.Role))
                    {
                        var toggle = RoleToggle(member);
                        var canKick = _isModerator
                            && _chat.Type != ChatTypeContract.Direct
                            && member.Status == MemberStatusContract.Active
                            && member.UserId != _userId
                            && member.Role != MemberRoleContract.Owner;
                        var canTransfer = _myRole == MemberRoleContract.Owner
                            && _chat.Type != ChatTypeContract.Direct
                            && member.Status == MemberStatusContract.Active
                            && member.UserId != _userId
                            && member.Role != MemberRoleContract.Owner;

                        <li class="list-group-item d-flex justify-content-between align-items-center
                                   @(member.Status != MemberStatusContract.Active ? "text-muted" : "")">
                            <div>
                                @DisplayName(member.UserId)
                                @if (member.UserId == _userId) { <span class="text-muted">(you)</span> }
                                <span class="badge bg-light text-dark ms-1">@member.Role</span>
                                @if (member.Status != MemberStatusContract.Active)
                                {
                                    <span class="badge bg-secondary ms-1">@member.Status</span>
                                }
                            </div>
                            <div class="btn-group btn-group-sm">
                                @if (toggle is not null && _isModerator && member.Status == MemberStatusContract.Active && member.UserId != _userId)
                                {
                                    <button class="btn btn-outline-secondary"
                                            @onclick="() => ChangeRoleAsync(member.UserId, toggle.Value.Target)"
                                            disabled="@_busyManage">
                                        @toggle.Value.Label
                                    </button>
                                }
                                @if (canTransfer)
                                {
                                    <button class="btn btn-outline-warning"
                                            @onclick="() => TransferAsync(member.UserId)" disabled="@_busyManage">
                                        Make owner
                                    </button>
                                }
                                @if (canKick)
                                {
                                    <button class="btn btn-outline-danger"
                                            @onclick="() => KickAsync(member.UserId)" disabled="@_busyManage">
                                        Kick
                                    </button>
                                }
                            </div>
                        </li>
                    }
                </ul>

                @if (_chat.Type != ChatTypeContract.Direct)
                {
                    <button class="btn btn-sm btn-outline-danger" @onclick="LeaveAsync" disabled="@_busyManage">
                        Leave chat
                    </button>
                }
            </div>
        </div>
    }

    <div class="border rounded p-3 mb-3" style="height: 50vh; overflow-y: auto; background: #f9f9f9;">
        @if (_messages.Count == 0)
        {
            <p class="text-muted text-center">No messages yet — say hi.</p>
        }
        else
        {
            @foreach (var m in _messages.OrderBy(x => x.SentAt))
            {
                var isMine = m.AuthorId == _userId;
                var reply = ReplyPreviewFor(m);
                <div class="d-flex mb-2 @(isMine ? "justify-content-end" : "")">
                    <div class="@(isMine ? "bg-primary text-white" : "bg-white border") rounded p-2 px-3" style="max-width: 70%;">
                        <div class="small @(isMine ? "text-white-50" : "text-muted")">
                            @(isMine ? "you" : DisplayName(m.AuthorId)) · @m.SentAt.ToLocalTime().ToString("HH:mm")
                            @if (m.ForwardOriginalMessageId is not null)
                            {
                                <span class="fst-italic"> · forwarded</span>
                            }
                        </div>

                        @if (reply is not null)
                        {
                            <div class="border-start ps-2 my-1 small @(isMine ? "border-light" : "border-secondary")"
                                 style="opacity:.85;">
                                ↪ @(isMine ? "" : DisplayName(reply.AuthorId) + ": ")@Snippet(reply)
                            </div>
                        }

                        <div>
                            @if (m.IsRetracted)
                            {
                                <em class="@(isMine ? "text-white-50" : "text-muted")">[retracted]</em>
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(m.Text))
                                {
                                    <div>@m.Text</div>
                                }
                                @foreach (var a in m.Attachments)
                                {
                                    @if (a.Type == AttachmentTypeContract.Image)
                                    {
                                        <img src="@a.Url" alt="@(a.FileName ?? "image")"
                                             class="img-fluid rounded mt-1" style="max-height: 220px;" />
                                    }
                                    else
                                    {
                                        <a href="@a.Url" target="_blank"
                                           class="d-block mt-1 @(isMine ? "text-white" : "")">
                                            📎 @(a.FileName ?? a.Url)
                                        </a>
                                    }
                                }
                            }
                        </div>

                        @if (!m.IsRetracted && m.Reactions.Count > 0)
                        {
                            <div class="mt-1">
                                @foreach (var group in m.Reactions.GroupBy(r => r.Emoji))
                                {
                                    var mine = group.Any(r => r.UserId == _userId);
                                    <button class="btn btn-sm py-0 px-1 me-1 @(mine ? "btn-light border" : "btn-outline-light border")"
                                            style="@(isMine ? "" : "color:#333;")"
                                            @onclick="() => ToggleReactionAsync(m, group.Key)">
                                        @Glyph(group.Key) @group.Count()
                                    </button>
                                }
                            </div>
                        }

                        @if (_chat.Type == ChatTypeContract.Broadcast && isMine && m.BroadcastReadCount is > 0)
                        {
                            <div class="small text-white-50 mt-1">👁 @m.BroadcastReadCount read</div>
                        }

                        @if (!m.IsRetracted)
                        {
                            <div class="mt-1">
                                <a class="small @(isMine ? "text-white-50" : "text-muted")" role="button"
                                   @onclick="() => ToggleReactPicker(m.MessageId)">react</a>
                                <span class="@(isMine ? "text-white-50" : "text-muted")"> · </span>
                                <a class="small @(isMine ? "text-white-50" : "text-muted")" role="button"
                                   @onclick="() => SetReply(m)">reply</a>
                                <span class="@(isMine ? "text-white-50" : "text-muted")"> · </span>
                                <a class="small @(isMine ? "text-white-50" : "text-muted")" role="button"
                                   @onclick="() => OpenForwardAsync(m)">forward</a>
                                <span class="@(isMine ? "text-white-50" : "text-muted")"> · </span>
                                <a class="small @(isMine ? "text-white-50" : "text-muted")" role="button"
                                   @onclick="() => HideAsync(m)">hide</a>
                                @if (isMine || _isModerator)
                                {
                                    <span class="@(isMine ? "text-white-50" : "text-muted")"> · </span>
                                    <a class="small @(isMine ? "text-white-50" : "text-muted")" role="button"
                                       @onclick="() => RetractAsync(m)">retract</a>
                                }
                            </div>
                            @if (_reactPickerFor == m.MessageId)
                            {
                                <div class="mt-1">
                                    @foreach (var (emoji, glyph) in AllEmojis)
                                    {
                                        <button class="btn btn-sm btn-light border py-0 px-1 me-1"
                                                @onclick="() => ToggleReactionAsync(m, emoji)">@glyph</button>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        }
    </div>

    @if (_replyTo is not null)
    {
        <div class="d-flex justify-content-between align-items-center bg-light border rounded px-3 py-1 mb-1 small">
            <span>↪ Replying to @DisplayName(_replyTo.AuthorId): @Snippet(_replyTo)</span>
            <button class="btn btn-sm btn-link text-decoration-none p-0" @onclick="CancelReply">✕</button>
        </div>
    }

    @if (_attachments.Count > 0)
    {
        <div class="mb-1">
            @for (var i = 0; i < _attachments.Count; i++)
            {
                var idx = i;
                var a = _attachments[i];
                <span class="badge bg-secondary me-1">
                    @a.Type: @(a.FileName ?? a.Url)
                    <span role="button" class="ms-1" @onclick="() => RemoveStagedAttachment(idx)">✕</span>
                </span>
            }
        </div>
    }

    <EditForm Model="@_send" OnValidSubmit="SendAsync" FormName="send-message">
        <div class="input-group">
            <button class="btn btn-outline-secondary" type="button" @onclick="() => _showAttach = !_showAttach">📎</button>
            <InputText class="form-control" placeholder="Type a message…"
                       @bind-Value="_send.Text" @oninput="OnInputAsync" />
            <button class="btn btn-primary" type="submit"
                    disabled="@(_sending || (string.IsNullOrWhiteSpace(_send.Text) && _attachments.Count == 0))">
                @(_sending ? "…" : "Send")
            </button>
        </div>
        @if (!string.IsNullOrEmpty(_sendError))
        {
            <div class="alert alert-danger mt-2">@_sendError</div>
        }
    </EditForm>

    @if (_showAttach)
    {
        <div class="card mt-2">
            <div class="card-body py-2">
                <div class="row g-2 align-items-end">
                    <div class="col-auto">
                        <label class="form-label small mb-0">Type</label>
                        <select class="form-select form-select-sm" @bind="_attachDraft.Type">
                            @foreach (var t in Enum.GetValues<AttachmentTypeContract>())
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div class="col">
                        <label class="form-label small mb-0">URL</label>
                        <input class="form-control form-control-sm" @bind="_attachDraft.Url" placeholder="https://…" />
                    </div>
                    <div class="col">
                        <label class="form-label small mb-0">File name (optional)</label>
                        <input class="form-control form-control-sm" @bind="_attachDraft.FileName" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label small mb-0">Size (bytes)</label>
                        <input type="number" class="form-control form-control-sm" @bind="_attachDraft.SizeBytes" style="width:110px;" />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="AddStagedAttachment">Attach</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@if (_forwardSource is not null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,.4);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Forward to…</h5>
                    <button type="button" class="btn-close" @onclick="CloseForward"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_forwardError))
                    {
                        <div class="alert alert-danger">@_forwardError</div>
                    }
                    @if (_forwardTargets is null)
                    {
                        <p>Loading…</p>
                    }
                    else if (_forwardTargets.Count == 0)
                    {
                        <p class="text-muted">No other chats to forward to.</p>
                    }
                    else
                    {
                        <ul class="list-group">
                            @foreach (var target in _forwardTargets)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@(target.Name ?? "(direct)") <span class="badge bg-light text-dark ms-1">@target.Type</span></span>
                                    <button class="btn btn-sm btn-primary" @onclick="() => ForwardToAsync(target.ChatId)"
                                            disabled="@_forwarding">
                                        Forward
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ChatId { get; set; }

    private Guid _userId;
    private ChatDetailsContract? _chat;
    private List<MessageContract> _messages = [];
    private SendModel _send = new();
    private string? _loadError;
    private string? _sendError;
    private string? _actionError;
    private bool _sending;
    private Timer? _poller;
    private IDisposable? _typingSubscription;
    private IDisposable? _newMessageSubscription;
    private IDisposable? _chatChangedSubscription;
    private readonly List<IDisposable> _presenceSubscriptions = new();
    private readonly Dictionary<Guid, DateTime> _typingExpiry = new();
    private List<Guid> _othersTyping = [];
    private int _onlineCount;
    private Dictionary<Guid, bool> _presence = new();
    private Dictionary<Guid, string> _usernames = new();
    private DateTime _lastTypingHitUtc = DateTime.MinValue;
    private static readonly TimeSpan TypingThrottle = TimeSpan.FromSeconds(2);
    private static readonly TimeSpan TypingTtl = TimeSpan.FromSeconds(5);

    // Actor capabilities
    private bool _isModerator;
    private bool _isPremium;
    private MemberRoleContract? _myRole;

    // Message-level UI state
    private MessageContract? _replyTo;
    private Guid? _reactPickerFor;

    // Forward modal
    private MessageContract? _forwardSource;
    private IReadOnlyList<ChatSummaryContract>? _forwardTargets;
    private bool _forwarding;
    private string? _forwardError;

    // Attachment composer
    private bool _showAttach;
    private readonly List<SendMessageAttachmentContract> _attachments = new();
    private AttachmentDraft _attachDraft = new();

    // Management panel
    private bool _showManage;
    private string? _renameValue;
    private bool _busyManage;

    private static readonly (EmojiContract Emoji, string Glyph)[] AllEmojis =
    {
        (EmojiContract.Like, "👍"),
        (EmojiContract.Heart, "❤️"),
        (EmojiContract.Laugh, "😂"),
        (EmojiContract.Wow, "😮"),
        (EmojiContract.Sad, "😢"),
        (EmojiContract.Angry, "😠"),
        (EmojiContract.Fire, "🔥"),
        (EmojiContract.Dislike, "👎"),
    };

    protected override async Task OnInitializedAsync()
    {
        var u = await CurrentUser.GetUserIdAsync();
        if (u is null) { Nav.NavigateTo("/login", forceLoad: true); return; }
        _userId = u.Value;

        await LoadChatAsync();
        await LoadUsernamesAsync();
        await LoadCapabilitiesAsync();
        await ReloadMessagesAsync();
        await RefreshPresenceAsync();
        await MarkChatNotificationsReadAsync();

        _typingSubscription = TypingPubSub.Subscribe(ChatId, OnRemoteTypingAsync);
        _newMessageSubscription = NewMessagePubSub.Subscribe(ChatId, OnNewMessageAsync);
        _chatChangedSubscription = ChatChangedPubSub.Subscribe(ChatId, OnChatChangedAsync);

        SubscribeToPresenceForMembers();

        _poller = new Timer(async _ => await InvokeAsync(PollAsync), null,
            TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private int _pollTick;

    private async Task PollAsync()
    {
        SweepExpiredTyping();
        if (++_pollTick % 10 == 0) await RefreshPresenceAsync();
    }

    private async Task LoadCapabilitiesAsync()
    {
        if (_chat is null) return;

        _myRole = _chat.Members
            .FirstOrDefault(m => m.UserId == _userId && m.Status == MemberStatusContract.Active)?.Role;

        try { _isModerator = await ChatsApi.IsModeratorAsync(_userId, ChatId, _userId); }
        catch { _isModerator = false; }

        try
        {
            var me = await IdentityUsers.GetUserByIdAsync(_userId);
            _isPremium = me?.IsPremium ?? false;
        }
        catch { _isPremium = false; }
    }

    private void SubscribeToPresenceForMembers()
    {
        if (_chat is null) return;

        foreach (var member in _chat.Members
            .Where(m => m.Status == MemberStatusContract.Active)
            .Where(m => m.UserId != _userId))
        {
            _presenceSubscriptions.Add(PresencePubSub.Subscribe(member.UserId, OnPresenceChangedAsync));
        }
    }

    private async Task OnPresenceChangedAsync(bool _)
    {
        await RefreshPresenceAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnNewMessageAsync(Guid _)
    {
        await ReloadMessagesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnChatChangedAsync()
    {
        await ReloadMessagesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadChatAsync()
    {
        try
        {
            _chat = await ChatsApi.GetChatByIdAsync(_userId, ChatId);
            if (_chat is null) _loadError = "Chat not found.";
        }
        catch (Exception ex) { _loadError = ex.Message; }
    }

    private async Task LoadUsernamesAsync()
    {
        if (_chat is null) return;
        try
        {
            var ids = _chat.Members.Select(m => m.UserId).ToList();
            var map = await IdentityUsers.GetUsernamesByIdsAsync(ids);
            _usernames = map.ToDictionary(kv => kv.Key, kv => kv.Value);
        }
        catch { /* fall back to GUID display */ }
    }

    private async Task ReloadMessagesAsync()
    {
        try
        {
            var page = await MessagingApi.GetChatMessagesAsync(_userId, ChatId);
            var grew = page.Items.Count > _messages.Count;
            _messages = page.Items.ToList();
            StateHasChanged();

            if (grew) await MarkChatNotificationsReadAsync();
        }
        catch { /* keep last good state */ }
    }

    private async Task MarkChatNotificationsReadAsync()
    {
        try { await NotificationsApi.MarkChatAsReadAsync(_userId, ChatId); }
        catch { /* best-effort */ }
    }

    private async Task RefreshPresenceAsync()
    {
        if (_chat is null) return;
        try
        {
            var members = _chat.Members
                .Where(m => m.Status == MemberStatusContract.Active)
                .Select(m => m.UserId)
                .Where(id => id != _userId)
                .ToList();

            if (members.Count == 0) return;

            var presence = await PresenceApi.GetBatchPresenceAsync(_userId, members);
            _presence = presence.ToDictionary(kv => kv.Key, kv => kv.Value);
            var online = _presence.Count(kv => kv.Value);
            if (online != _onlineCount)
            {
                _onlineCount = online;
            }
            StateHasChanged();
        }
        catch { /* best-effort */ }
    }

    private async Task OnRemoteTypingAsync(Guid userId)
    {
        if (userId == _userId) return;

        _typingExpiry[userId] = DateTime.UtcNow + TypingTtl;
        RebuildTypingList();
        await InvokeAsync(StateHasChanged);
    }

    private void SweepExpiredTyping()
    {
        var now = DateTime.UtcNow;
        var expired = _typingExpiry.Where(kv => kv.Value <= now).Select(kv => kv.Key).ToList();
        if (expired.Count == 0) return;

        foreach (var id in expired) _typingExpiry.Remove(id);
        RebuildTypingList();
        StateHasChanged();
    }

    private void RebuildTypingList()
    {
        var newList = _typingExpiry.Keys.OrderBy(x => x).ToList();
        if (!_othersTyping.SequenceEqual(newList))
            _othersTyping = newList;
    }

    private async Task OnInputAsync(ChangeEventArgs e)
    {
        _send.Text = e.Value?.ToString() ?? "";

        if (string.IsNullOrWhiteSpace(_send.Text)) return;

        var now = DateTime.UtcNow;
        if (now - _lastTypingHitUtc < TypingThrottle) return;
        _lastTypingHitUtc = now;

        try { await PresenceApi.StartTypingAsync(_userId, ChatId); }
        catch { /* best-effort */ }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_send.Text) && _attachments.Count == 0) return;
        if (_chat is null) return;

        _sendError = null;
        _sending = true;
        try
        {
            // BFF enrichment: Messaging has no access to Chats data, so we resolve
            // recipients (all active members except author) and broadcast flag here.
            var recipients = _chat.Members
                .Where(m => m.Status == MemberStatusContract.Active && m.UserId != _userId)
                .Select(m => m.UserId)
                .ToList();

            var isBroadcast = _chat.Type == ChatTypeContract.Broadcast;

            await MessagingApi.SendMessageAsync(
                authorUserId: _userId,
                chatId: ChatId,
                text: string.IsNullOrWhiteSpace(_send.Text) ? null : _send.Text,
                recipients: recipients,
                isBroadcast: isBroadcast,
                attachments: _attachments.Count > 0 ? _attachments.ToList() : null,
                replyToMessageId: _replyTo?.MessageId);

            _send = new SendModel();
            _attachments.Clear();
            _replyTo = null;
            _showAttach = false;
            await ReloadMessagesAsync();
            try { await PresenceApi.StopTypingAsync(_userId, ChatId); } catch { }
        }
        catch (Exception ex) { _sendError = ex.Message; }
        finally { _sending = false; }
    }

    // ---- Reactions ----

    private void ToggleReactPicker(Guid messageId)
        => _reactPickerFor = _reactPickerFor == messageId ? null : messageId;

    private async Task ToggleReactionAsync(MessageContract m, EmojiContract emoji)
    {
        _sendError = null;
        var mine = m.Reactions.Any(r => r.UserId == _userId && r.Emoji == emoji);
        try
        {
            if (mine)
                await MessagingApi.RemoveReactionAsync(_userId, m.MessageId, emoji);
            else
                await MessagingApi.AddReactionAsync(_userId, m.MessageId, emoji, _isPremium);

            _reactPickerFor = null;
            await ReloadMessagesAsync();
        }
        catch (Exception ex) { _sendError = ex.Message; }
    }

    // ---- Reply ----

    private void SetReply(MessageContract m) => _replyTo = m;
    private void CancelReply() => _replyTo = null;

    private MessageContract? ReplyPreviewFor(MessageContract m)
        => m.ReplyToMessageId is null
            ? null
            : _messages.FirstOrDefault(x => x.MessageId == m.ReplyToMessageId);

    // ---- Retract / Hide ----

    private async Task RetractAsync(MessageContract m)
    {
        _sendError = null;
        try
        {
            await MessagingApi.RetractMessageAsync(_userId, m.MessageId, _isModerator);
            await ReloadMessagesAsync();
        }
        catch (Exception ex) { _sendError = ex.Message; }
    }

    private async Task HideAsync(MessageContract m)
    {
        _sendError = null;
        try
        {
            await MessagingApi.HideMessageAsync(_userId, m.MessageId);
            _messages.RemoveAll(x => x.MessageId == m.MessageId);
            StateHasChanged();
        }
        catch (Exception ex) { _sendError = ex.Message; }
    }

    // ---- Forward ----

    private async Task OpenForwardAsync(MessageContract m)
    {
        _forwardSource = m;
        _forwardError = null;
        _forwardTargets = null;
        StateHasChanged();
        try
        {
            var all = await ChatsApi.GetMyChatsAsync(_userId);
            _forwardTargets = all.Where(c => c.ChatId != ChatId).ToList();
        }
        catch (Exception ex) { _forwardError = ex.Message; }
    }

    private void CloseForward()
    {
        _forwardSource = null;
        _forwardTargets = null;
        _forwardError = null;
    }

    private async Task ForwardToAsync(Guid targetChatId)
    {
        if (_forwardSource is null) return;
        _forwardError = null;
        _forwarding = true;
        try
        {
            var recipients = await ChatsApi.GetActiveRecipientsAsync(_userId, targetChatId, _userId);
            var type = await ChatsApi.GetChatTypeAsync(_userId, targetChatId);

            await MessagingApi.SendMessageAsync(
                authorUserId: _userId,
                chatId: targetChatId,
                text: _forwardSource.Text,
                recipients: recipients,
                isBroadcast: type == ChatTypeContract.Broadcast,
                attachments: _forwardSource.Attachments
                    .Select(a => new SendMessageAttachmentContract(a.Type, a.Url, a.SizeBytes, a.FileName))
                    .ToList(),
                forwardOriginalMessageId: _forwardSource.MessageId,
                forwardOriginalChatId: ChatId);

            CloseForward();
            Nav.NavigateTo($"/chat/{targetChatId}");
        }
        catch (Exception ex) { _forwardError = ex.Message; }
        finally { _forwarding = false; }
    }

    // ---- Attachments composer ----

    private void AddStagedAttachment()
    {
        if (string.IsNullOrWhiteSpace(_attachDraft.Url)) { _sendError = "Attachment URL is required."; return; }
        var size = _attachDraft.SizeBytes <= 0 ? 1 : _attachDraft.SizeBytes;
        _attachments.Add(new SendMessageAttachmentContract(
            _attachDraft.Type,
            _attachDraft.Url.Trim(),
            size,
            string.IsNullOrWhiteSpace(_attachDraft.FileName) ? null : _attachDraft.FileName!.Trim()));
        _attachDraft = new AttachmentDraft();
    }

    private void RemoveStagedAttachment(int index)
    {
        if (index >= 0 && index < _attachments.Count) _attachments.RemoveAt(index);
    }

    // ---- Management panel ----

    private void ToggleManage()
    {
        _showManage = !_showManage;
        _actionError = null;
        if (_showManage) _renameValue = _chat?.Name;
    }

    private async Task ReloadChatDetailsAsync()
    {
        await LoadChatAsync();
        await LoadUsernamesAsync();
        await LoadCapabilitiesAsync();
        StateHasChanged();
    }

    private async Task RenameAsync()
    {
        if (string.IsNullOrWhiteSpace(_renameValue)) { _actionError = "Name is required."; return; }
        _actionError = null;
        _busyManage = true;
        try
        {
            await ChatsApi.RenameChatAsync(_userId, ChatId, _renameValue.Trim());
            await ReloadChatDetailsAsync();
        }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _busyManage = false; }
    }

    private async Task KickAsync(Guid targetUserId)
    {
        _actionError = null;
        _busyManage = true;
        try
        {
            await ChatsApi.KickMemberAsync(_userId, ChatId, targetUserId);
            await ReloadChatDetailsAsync();
        }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _busyManage = false; }
    }

    private async Task ChangeRoleAsync(Guid targetUserId, MemberRoleContract newRole)
    {
        _actionError = null;
        _busyManage = true;
        try
        {
            await ChatsApi.ChangeMemberRoleAsync(_userId, ChatId, targetUserId, newRole);
            await ReloadChatDetailsAsync();
        }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _busyManage = false; }
    }

    private async Task TransferAsync(Guid newOwnerUserId)
    {
        _actionError = null;
        _busyManage = true;
        try
        {
            await ChatsApi.TransferOwnershipAsync(_userId, ChatId, newOwnerUserId);
            await ReloadChatDetailsAsync();
        }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _busyManage = false; }
    }

    private async Task LeaveAsync()
    {
        _actionError = null;
        _busyManage = true;
        try
        {
            await ChatsApi.LeaveChatAsync(_userId, ChatId);
            Nav.NavigateTo("/");
        }
        catch (Exception ex) { _actionError = ex.Message; _busyManage = false; }
    }

    private (string Label, MemberRoleContract Target)? RoleToggle(ChatMemberContract member)
    {
        if (_chat is null || member.Role == MemberRoleContract.Owner) return null;

        return _chat.Type switch
        {
            ChatTypeContract.Group => member.Role == MemberRoleContract.Admin
                ? ("Demote to member", MemberRoleContract.Member)
                : ("Promote to admin", MemberRoleContract.Admin),
            ChatTypeContract.Broadcast => member.Role == MemberRoleContract.Admin
                ? ("Demote to viewer", MemberRoleContract.Viewer)
                : ("Promote to admin", MemberRoleContract.Admin),
            _ => null
        };
    }

    public async ValueTask DisposeAsync()
    {
        _typingSubscription?.Dispose();
        _newMessageSubscription?.Dispose();
        _chatChangedSubscription?.Dispose();
        foreach (var sub in _presenceSubscriptions) sub.Dispose();
        if (_poller is not null) await _poller.DisposeAsync();
        try { await PresenceApi.StopTypingAsync(_userId, ChatId); } catch { }
    }

    private string DisplayName(Guid userId) =>
        _usernames.TryGetValue(userId, out var name) ? name : userId.ToString()[..8];

    // The other participant in a direct (1:1) chat, from the current user's point of view.
    private ChatMemberContract? OtherDirectMember() =>
        _chat?.Members.FirstOrDefault(m => m.UserId != _userId);

    private string ChatTitle()
    {
        if (_chat is null) return "Chat";
        if (_chat.Type == ChatTypeContract.Direct)
        {
            var peer = OtherDirectMember();
            return peer is not null ? DisplayName(peer.UserId) : "Direct chat";
        }
        return _chat.Name ?? "Chat";
    }

    private bool IsOnline(Guid userId) =>
        _presence.TryGetValue(userId, out var online) && online;

    private static string Glyph(EmojiContract e) => AllEmojis.First(x => x.Emoji == e).Glyph;

    private string Snippet(MessageContract m)
    {
        if (m.IsRetracted) return "[retracted]";
        if (!string.IsNullOrWhiteSpace(m.Text))
            return m.Text!.Length > 60 ? m.Text[..60] + "…" : m.Text;
        if (m.Attachments.Count > 0) return $"[{m.Attachments[0].Type.ToString().ToLowerInvariant()}]";
        return "[message]";
    }

    private string TypingLabel(IReadOnlyCollection<Guid> users) => users.Count switch
    {
        0 => "",
        1 => $"{DisplayName(users.First())} is typing…",
        2 => $"{DisplayName(users.ElementAt(0))} and {DisplayName(users.ElementAt(1))} are typing…",
        _ => $"{users.Count} people are typing…"
    };

    private sealed class SendModel
    {
        public string Text { get; set; } = "";
    }

    private sealed class AttachmentDraft
    {
        public AttachmentTypeContract Type { get; set; } = AttachmentTypeContract.Image;
        public string Url { get; set; } = "";
        public string? FileName { get; set; }
        public long SizeBytes { get; set; } = 1;
    }
}
