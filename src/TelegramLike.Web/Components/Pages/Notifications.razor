@page "/notifications"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using TelegramLike.Contracts.Notifications
@using TelegramLike.Web.Services
@using TelegramLike.Client.Notifications
@inject INotificationsApi NotificationsApi
@inject CurrentUserAccessor CurrentUser
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Notifications</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h4">Notifications</MudText>
    <div class="d-flex align-center" style="gap:12px">
        <MudSwitch T="bool" Value="showUnreadOnly" ValueChanged="OnUnreadOnlyToggledAsync"
                   Color="Color.Primary" Label="Unread only" />
        <MudButton OnClick="MarkAllNotificationsReadAsync" Variant="Variant.Outlined" Size="Size.Small"
                   Disabled="isSubmitting" StartIcon="@Icons.Material.Filled.DoneAll">
            Mark all as read
        </MudButton>
    </div>
</div>

@if (notificationFeed is null && loadFailed)
{
    <MudAlert Severity="Severity.Warning">Notifications are temporarily unavailable. Retrying…</MudAlert>
}
else if (notificationFeed is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (notificationFeed.Items.Count == 0)
{
    <MudAlert Severity="Severity.Info">Nothing to show.</MudAlert>
}
else
{
    @if (loadFailed)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
            Showing the last update — the notifications service is temporarily unavailable.
        </MudAlert>
    }
    <MudList T="string" Class="pa-0">
        @foreach (var notification in notificationFeed.Items)
        {
            var isUnread = notification.Status != NotificationStatus.Read;
            <MudListItem T="string">
                <div class="d-flex align-center justify-space-between" style="width:100%">
                    <div>
                        <MudText Typo="Typo.body1"
                                 Style="@(isUnread ? "font-weight:600" : "opacity:.7")">
                            @DescribeNotification(notification)
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @notification.CreatedAt.ToLocalTime().ToString("g") · @notification.Status
                        </MudText>
                    </div>
                    <div class="d-flex align-center" style="gap:8px">
                        <MudButton Href="@($"/chat/{notification.ChatId}")" Variant="Variant.Outlined"
                                   Size="Size.Small" Color="Color.Primary">Open chat</MudButton>
                        @if (isUnread)
                        {
                            <MudButton OnClick="() => MarkNotificationReadAsync(notification.Id)"
                                       Variant="Variant.Text" Size="Size.Small" Disabled="isSubmitting">
                                Mark read
                            </MudButton>
                        }
                    </div>
                </div>
            </MudListItem>
            <MudDivider />
        }
    </MudList>
}

@code {
    private Guid currentUserId;
    private NotificationFeedApiDto? notificationFeed;
    // Default to unread-only so notifications cleared by chat-view (via MarkChatAsRead)
    // disappear from the list automatically. User can toggle to see the full audit log.
    private bool showUnreadOnly = true;
    private bool isSubmitting;
    // Set when a load fails (e.g. Notifications service down / circuit open). Drives a
    // quiet "temporarily unavailable" state instead of an eternal "Loading…" spinner.
    private bool loadFailed;
    private Timer? refreshTimer;
    private volatile bool isDisposed;

    protected override async Task OnInitializedAsync()
    {
        var user = await CurrentUser.GetUserIdAsync();
        if (user is null) { Navigation.NavigateTo("/login", forceLoad: true); return; }
        currentUserId = user.Value;
        await ReloadFeedAsync();

        refreshTimer = new Timer(async _ =>
        {
            // Guard against firing into a torn-down circuit (tab closed mid-interval),
            // which would otherwise throw ObjectDisposedException on a threadpool thread.
            if (isDisposed) return;
            try { await InvokeAsync(ReloadFeedAsync); }
            catch (ObjectDisposedException) { /* circuit gone before the timer fired */ }
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private async Task ReloadFeedAsync()
    {
        try
        {
            notificationFeed = await NotificationsApi.GetFeedAsync(currentUserId, unreadOnly: showUnreadOnly);
            loadFailed = false;
            StateHasChanged();
        }
        catch
        {
            // Keep the last good feed (if any); surface a quiet unavailable state.
            loadFailed = true;
            StateHasChanged();
        }
    }

    private async Task OnUnreadOnlyToggledAsync(bool unreadOnly)
    {
        showUnreadOnly = unreadOnly;
        await ReloadFeedAsync();
    }

    private async Task MarkNotificationReadAsync(Guid notificationId)
    {
        isSubmitting = true;
        try
        {
            await NotificationsApi.MarkAsReadAsync(currentUserId, notificationId);
            await ReloadFeedAsync();
        }
        finally { isSubmitting = false; }
    }

    private async Task MarkAllNotificationsReadAsync()
    {
        isSubmitting = true;
        try
        {
            await NotificationsApi.MarkAllAsReadAsync(currentUserId);
            await ReloadFeedAsync();
        }
        finally { isSubmitting = false; }
    }

    public async ValueTask DisposeAsync()
    {
        isDisposed = true;
        if (refreshTimer is not null) await refreshTimer.DisposeAsync();
    }

    private static string DescribeNotification(NotificationApiDto notification) => notification.Type switch
    {
        NotificationType.NewMessage => "New message in a chat",
        NotificationType.MentionInGroup => "You were mentioned",
        NotificationType.MemberJoined => "Someone joined the chat",
        NotificationType.MemberKicked => "A member was removed",
        _ => notification.Type.ToString()
    };
}
