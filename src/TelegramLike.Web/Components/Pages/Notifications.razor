@page "/notifications"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using TelegramLike.Contracts.Notifications
@using TelegramLike.Web.Services
@using TelegramLike.Web.Services.NotificationsApi
@inject INotificationsApi NotificationsApi
@inject CurrentUserAccessor CurrentUser
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Notifications</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Notifications</h1>
    <div>
        <div class="form-check form-switch d-inline-block me-3">
            <input class="form-check-input" type="checkbox" id="unreadOnly"
                   checked="@_unreadOnly" @onchange="ToggleUnreadAsync" />
            <label class="form-check-label" for="unreadOnly">Unread only</label>
        </div>
        <button class="btn btn-sm btn-outline-secondary" @onclick="MarkAllAsync" disabled="@_busy">
            Mark all as read
        </button>
    </div>
</div>

@if (_feed is null)
{
    <p>Loading…</p>
}
else if (_feed.Items.Count == 0)
{
    <div class="alert alert-info">Nothing to show.</div>
}
else
{
    <ul class="list-group">
        @foreach (var n in _feed.Items)
        {
            <li class="list-group-item d-flex justify-content-between align-items-start
                       @(n.Status != NotificationStatusContract.Read ? "fw-semibold" : "text-muted")">
                <div>
                    <div>@Describe(n)</div>
                    <small class="text-muted">@n.CreatedAt.ToLocalTime().ToString("g") · @n.Status</small>
                </div>
                <div class="btn-group btn-group-sm">
                    <a class="btn btn-outline-primary" href="/chat/@n.ChatId">Open chat</a>
                    @if (n.Status != NotificationStatusContract.Read)
                    {
                        <button class="btn btn-outline-secondary" @onclick="() => MarkOneAsync(n.Id)" disabled="@_busy">
                            Mark read
                        </button>
                    }
                </div>
            </li>
        }
    </ul>
}

@code {
    private NotificationFeedApiDto? _feed;
    private bool _unreadOnly;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var u = await CurrentUser.GetUserIdAsync();
        if (u is null) { Nav.NavigateTo("/login", forceLoad: true); return; }
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _feed = await NotificationsApi.GetFeedAsync(unreadOnly: _unreadOnly);
    }

    private async Task ToggleUnreadAsync(ChangeEventArgs e)
    {
        _unreadOnly = e.Value is bool b && b;
        await ReloadAsync();
    }

    private async Task MarkOneAsync(Guid id)
    {
        _busy = true;
        try
        {
            await NotificationsApi.MarkAsReadAsync(id);
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private async Task MarkAllAsync()
    {
        _busy = true;
        try
        {
            await NotificationsApi.MarkAllAsReadAsync();
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private static string Describe(NotificationApiDto n) => n.Type switch
    {
        NotificationTypeContract.NewMessage => "New message in a chat",
        NotificationTypeContract.MentionInGroup => "You were mentioned",
        NotificationTypeContract.MemberJoined => "Someone joined the chat",
        NotificationTypeContract.MemberKicked => "A member was removed",
        _ => n.Type.ToString()
    };
}
