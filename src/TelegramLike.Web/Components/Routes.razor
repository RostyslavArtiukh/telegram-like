<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1, h2, h3, h4" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <MudAlert Severity="Severity.Warning" Class="my-4">
                <MudText Typo="Typo.h6">Page not found</MudText>
                <MudText Typo="Typo.body2">Sorry, there's nothing at this address.</MudText>
                <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-2">
                    Go to Chats
                </MudButton>
            </MudAlert>
        </LayoutView>
    </NotFound>
</Router>
