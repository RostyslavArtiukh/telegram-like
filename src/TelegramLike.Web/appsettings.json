{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017/?replicaSet=rs0&directConnection=true",
    "DatabaseName": "telegramlike"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Auth": {
    "SessionTokenTtlDays": 7
  },
  "Presence": {
    "HeartbeatTtlSeconds": 30,
    "TypingTtlSeconds": 5
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest"
  },
  "Outbox": {
    "PollIntervalSeconds": 2,
    "BatchSize": 50
  },
  "NotificationsApi": {
    "BaseUrl": "http://localhost:8081"
  }
}
