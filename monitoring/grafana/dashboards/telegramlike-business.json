{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "title": "TelegramLike — Product & Outbox",
  "uid": "telegramlike-business",
  "tags": ["telegramlike"],
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "description": "Scopes the outbox panels. Sourced from the outbox gauge itself, so only services that actually run the queue show up.",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(telegramlike_outbox_pending, job)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Messages sent (per second)",
      "description": "The product's pulse. HTTP traffic can look healthy while this sits at zero — that gap is the whole reason this dashboard exists.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(telegramlike_messages_sent_total[$__rate_interval]))",
          "legendFormat": "msg/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Chats created (last hour)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(telegramlike_chats_created_total[1h]))",
          "legendFormat": "chats"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Outbox pending (worst service)",
      "description": "Depth alone doesn't mean trouble — a burst drains in seconds. Read it next to the age panel.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 500 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(telegramlike_outbox_pending{job=~\"$service\"})",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Oldest unpublished event",
      "description": "The real lag signal, and what OutboxStalled alerts on. A healthy head is a few seconds old — bounded below by the sender's poll interval.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "red", "value": 60 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(telegramlike_outbox_oldest_pending_age_seconds{job=~\"$service\"})",
          "legendFormat": "age"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Messages sent by kind",
      "description": "kind = new / reply / forward, split by broadcast vs regular chat.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (kind, broadcast) (rate(telegramlike_messages_sent_total[$__rate_interval]))",
          "legendFormat": "{{kind}} (broadcast={{broadcast}})"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Chat lifecycle & membership churn",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (kind) (rate(telegramlike_chats_created_total[$__rate_interval]))",
          "legendFormat": "created: {{kind}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (change) (rate(telegramlike_chat_membership_changes_total[$__rate_interval]))",
          "legendFormat": "member {{change}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Outbox depth by service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "telegramlike_outbox_pending{job=~\"$service\"}",
          "legendFormat": "{{job}} pending"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "telegramlike_outbox_dead_lettered_backlog{job=~\"$service\"}",
          "legendFormat": "{{job}} dead-lettered"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Outbox lag — age of the oldest unpublished event",
      "description": "Sawtooth is healthy: it climbs to roughly the poll interval, then drops as the batch is drained. A staircase that never resets means the sender is stuck.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "thresholdsStyle": { "mode": "dashed" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 60 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "telegramlike_outbox_oldest_pending_age_seconds{job=~\"$service\"}",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Integration events published by type (per second)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (event_type) (rate(telegramlike_outbox_published_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{event_type}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Outbox publish delay (p50 / p95)",
      "description": "Time from an event being written inside the business transaction to reaching the broker. The floor is the sender's poll interval — this is the price the outbox pays for atomicity.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (job, le) (rate(telegramlike_outbox_publish_delay_seconds_bucket{job=~\"$service\"}[5m])))",
          "legendFormat": "{{job}} p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(telegramlike_outbox_publish_delay_seconds_bucket{job=~\"$service\"}[5m])))",
          "legendFormat": "{{job}} p95"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "RabbitMQ — deepest queues",
      "description": "Per-queue depth from the broker's /metrics/detailed endpoint. topk keeps the graph readable: the stack declares dozens of queues and almost all sit at zero.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(10, rabbitmq_detailed_queue_messages_ready{vhost=\"telegramlike\"})",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Outbox failures & dead letters",
      "description": "Empty is the healthy state — an OTel counter has no series until its first increment, so \"No data\" here means nothing has ever failed. Catches per-event faults (bad payload, unresolvable type), NOT a broker outage: MassTransit blocks waiting to reconnect rather than throwing, so a RabbitMQ outage shows up on the lag panel instead. Retries are survivable; a dead letter is silent data loss.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job) (rate(telegramlike_outbox_publish_failures_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{job}} retryable failures"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job) (rate(telegramlike_outbox_dead_lettered_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{job}} dead-lettered"
        }
      ]
    }
  ]
}
