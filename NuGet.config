<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- The shared layer ships as versioned packages, so services resolve it the way they
         resolve any third-party dependency. A real deployment would point this at an internal
         feed (Azure Artifacts, GitHub Packages); locally the "feed" is the folder `dotnet pack`
         writes to, which is enough to make the version boundary real without hosting anything.
         Populate it with: dotnet pack TelegramLike.Shared.slnx -c Release -->
    <add key="telegramlike-local" value="artifacts/packages" />
  </packageSources>
</configuration>
